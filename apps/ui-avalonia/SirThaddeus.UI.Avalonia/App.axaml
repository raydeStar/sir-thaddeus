<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SirThaddeus.UI.Avalonia.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SirThaddeus.UI.Avalonia/Themes/ThemeResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Global Window Chrome -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Inter, system-ui, sans-serif"/>
    </Style>

    <Style Selector="Button.iconButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iconButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.iconButton:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <Style Selector="Button.statusDotButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.workspaceConnectionState">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,1,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.workspaceTitle">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.workspaceConversationTitle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.chatHistoryToggle">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="ToggleButton.iconToggleButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.iconToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="ToggleButton.iconToggleButton:checked">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
    </Style>

    <Style Selector="TextBox.landingInput">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.sendIconButton">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.sendIconButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
    </Style>
    <Style Selector="Button.sendIconButton:pressed">
        <Setter Property="RenderTransform" Value="scale(1.05)"/>
    </Style>

    <Style Selector="Button.stopIconButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.stopAllIconButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.stopAllIconButton:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Border.runtimeStatusPill">
        <Setter Property="Background" Value="#08FFFFFF"/>
        <Setter Property="BorderBrush" Value="#24FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>
    <Style Selector="Border.recentActivityPanel">
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="Border.recentActivityIconShell">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBlock.recentActivityHeader">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="TextBlock.recentActivityTitle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.recentActivityDetail">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <Style Selector="TextBlock.recentActivityMeta">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <Style Selector="TextBlock.runtimeStatusLabel">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <Style Selector="TextBlock.runtimeStatusValue">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.suggestionChipButton">
        <Setter Property="Background" Value="#08FFFFFF"/>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="15,11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.suggestionChipButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
        <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
    <Style Selector="Button.suggestionChipButton:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style Selector="Border.homeHeroMedallion">
        <Setter Property="BoxShadow" Value="0 6 22 0 #16000000"/>
    </Style>
    <Style Selector="TextBlock.homeHeroTitle">
        <Setter Property="LetterSpacing" Value="0.2"/>
    </Style>
    <Style Selector="TextBlock.homeHeroSubtitle">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MaxWidth" Value="420"/>
    </Style>

    <Style Selector="Border.chatMessageCard">
        <Setter Property="Background" Value="#111722"/>
        <Setter Property="BorderBrush" Value="#1E2A36"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style Selector="Border.chatMessageCard:pointerover">
        <Setter Property="Background" Value="#131B27"/>
        <Setter Property="BorderBrush" Value="#263646"/>
    </Style>
    <Style Selector="TextBlock.chatMessageAuthor">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.chatMessageTimestamp">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <Style Selector="TextBlock.chatMessageMetaSeparator">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <Style Selector="TextBlock.chatMessageToolSummary">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>

    <Style Selector="Button.composerIconButton">
        <Setter Property="Opacity" Value="0.68"/>
    </Style>
    <Style Selector="Button.composerIconButton:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Border.activityRailSummaryCard">
        <Setter Property="Background" Value="#0AFFFFFF"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.activityRailPanel">
        <Setter Property="Background" Value="#08FFFFFF"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12,12"/>
    </Style>
    <Style Selector="Border.activityRailItemCard">
        <Setter Property="Background" Value="#06FFFFFF"/>
        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.activityRailDetailCard">
        <Setter Property="Background" Value="#111821"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.activityRailStatusBadge">
        <Setter Property="Background" Value="#16202B"/>
        <Setter Property="BorderBrush" Value="#23384B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style Selector="TextBlock.activityRailSectionHeader">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="TextBlock.activityRailKey">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <Style Selector="TextBlock.activityRailValue">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.activityRailAdvancedLink">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="TextBlock.activityRailDisclosureLabel">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="TextBox.activityRailRawPayload">
        <Setter Property="Background" Value="#05000000"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Expander.activityRailExpander">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Expander.activityRailExpander /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="Button.activityRailDisclosureButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.activityRailDisclosureButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#06FFFFFF"/>
    </Style>
    <Style Selector="Border.activityRailInlineDetailPanel">
        <Setter Property="Background" Value="#0A1017"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ListBox.activityRailList">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.activityRailList ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.activityRailList ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.activityRailList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.activityRailList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.activityRailList ListBoxItem:pointerover Border.activityRailItemCard">
        <Setter Property="Background" Value="#0AFFFFFF"/>
    </Style>
    <Style Selector="ListBox.activityRailList ListBoxItem:selected Border.activityRailItemCard">
        <Setter Property="Background" Value="#11202A"/>
        <Setter Property="BorderBrush" Value="#29445A"/>
    </Style>
    <Style Selector="Border.progressRailSummaryCard">
        <Setter Property="Background" Value="#121821"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="TextBlock.progressRailSectionHeader">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Border.progressRailItemCard">
        <Setter Property="Background" Value="#101720"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.progressRailStateShell">
        <Setter Property="Background" Value="#17202B"/>
        <Setter Property="BorderBrush" Value="#22384D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
    </Style>

    <!-- Message triple-dot menu: hidden until parent hovered -->
    <Style Selector="Button.messageMenuBtn">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border:pointerover Button.messageMenuBtn">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Strip Fluent theme inner background from composer TextBox -->
    <Style Selector="TextBox#PromptBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="TextBox#PromptBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox#PromptBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Chat Input (Text Box) -->
    <Style Selector="TextBox.chatInput">
        <Setter Property="Background"              Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Foreground"              Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush"              Value="{StaticResource BlueBrush}"/>
        <Setter Property="BorderBrush"             Value="{StaticResource Surface1Brush}"/>
        <Setter Property="BorderThickness"         Value="1"/>
        <Setter Property="CornerRadius"            Value="{StaticResource RadiusInput}"/>
        <Setter Property="Padding"                 Value="16,12"/>
        <Setter Property="FontSize"                Value="15"/>
        <Setter Property="SelectionBrush"          Value="{StaticResource BlueBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox.chatInput:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource Surface2Brush}"/>
    </Style>
    <Style Selector="TextBox.chatInput:focus">
        <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
    </Style>

    <!-- Primary Button (Send / Confirm) -->
    <Style Selector="Button.sendBtn">
        <Setter Property="Background"      Value="{StaticResource BlueBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Padding"         Value="24,10"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusLg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.sendBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SapphireBrush}"/>
    </Style>
    <Style Selector="Button.sendBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- Danger Button (Cancel / STOP) -->
    <Style Selector="Button.cancelBtn">
        <Setter Property="Background"      Value="{StaticResource RedBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="Padding"         Value="14,7"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusLg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Opacity"         Value="0.92"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.cancelBtn:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.cancelBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource RedLightBrush}"/>
    </Style>

    <!-- Ghost / Header Button -->
    <Style Selector="Button.headerBtn">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource Overlay1Brush}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="Padding"         Value="14,8"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMd}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.headerBtn:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Button.headerBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    </Style>

    <!-- Subtle Action Button -->
    <Style Selector="Button.actionBtn">
        <Setter Property="Background"      Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Foreground"      Value="{StaticResource Subtext1Brush}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="Padding"         Value="14,8"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMd}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.actionBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Surface2Brush}"/>
    </Style>
    <Style Selector="Button.actionBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <!-- PTT Button State Classes -->
    <Style Selector="Button.pttListening">
        <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.pttListening:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SapphireBrush}"/>
    </Style>

    <Style Selector="Button.pttProcessing">
        <Setter Property="Background" Value="{StaticResource YellowBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.pttProcessing:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource YellowBrush}"/>
    </Style>

    <Style Selector="Button.pttSpeaking">
        <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.pttSpeaking:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
    </Style>

    <Style Selector="Button.pttResponding">
        <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.pttResponding:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SapphireBrush}"/>
    </Style>

    <!-- Approve Button (Green) -->
    <Style Selector="Button.approveBtn">
        <Setter Property="Background"      Value="{StaticResource GreenBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Padding"         Value="20,10"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusLg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.approveBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- Deny Button (Red) -->
    <Style Selector="Button.denyBtn">
        <Setter Property="Background"      Value="{StaticResource RedBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Padding"         Value="20,10"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusLg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.denyBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- Allow Once (Outlined / Neutral) -->
    <Style Selector="Button.allowOnceBtn">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource Subtext1Brush}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMd}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.allowOnceBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Overlay0Brush}"/>
    </Style>
    <Style Selector="Button.allowOnceBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- Allow Session (Teal) -->
    <Style Selector="Button.allowSessionBtn">
        <Setter Property="Background"      Value="{StaticResource TealBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMd}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.allowSessionBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- Allow Always (Mauve / Purple) -->
    <Style Selector="Button.allowAlwaysBtn">
        <Setter Property="Background"      Value="{StaticResource MauveBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMd}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.allowAlwaysBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- View Tab (Header toggle for Chat/Briefing/Settings) -->
    <Style Selector="ToggleButton.viewTab">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource Overlay0Brush}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Padding"         Value="18,10"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="CornerRadius"    Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.viewTab:checked">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
    </Style>
    <Style Selector="ToggleButton.viewTab:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Subtext1Brush}"/>
    </Style>
    <Style Selector="ToggleButton.viewTab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Transcript / Read-Only TextBox -->
    <Style Selector="TextBox.transcript">
        <Setter Property="Background"      Value="{StaticResource BaseBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="16,12"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="IsReadOnly"      Value="True"/>
        <Setter Property="TextWrapping"    Value="Wrap"/>
        <Setter Property="CaretBrush"      Value="{StaticResource BlueBrush}"/>
        <Setter Property="SelectionBrush"  Value="{StaticResource BlueBrush}"/>
    </Style>

    <!-- ListBox general -->
    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Padding"    Value="12,6"/>
    </Style>

    <!-- Settings Left Sidebar TabControl -->
    <Style Selector="TabControl.settingsTabs">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabControl.settingsTabs > TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Overlay1Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="20,10,24,10"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="TabControl.settingsTabs > TabItem:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="TabControl.settingsTabs > TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TabControl.settingsTabs > TabItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    </Style>
    <Style Selector="TabControl.settingsTabs > TabItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    </Style>

    <!-- Settings Section Label (replaces garish colored headers) -->
    <Style Selector="TextBlock.sectionLabel">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Overlay0Brush}"/>
        <Setter Property="LetterSpacing" Value="1.2"/>
        <Setter Property="Margin" Value="0,4,0,2"/>
    </Style>

    <!-- Settings Card -->
    <Style Selector="Border.settingsCard">
        <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <!-- Settings form label -->
    <Style Selector="TextBlock.formLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Subtext1Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Settings hint text -->
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Overlay0Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <!-- CheckBox in settings -->
    <Style Selector="CheckBox.settingsCheck">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Subtext1Brush}"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <!-- Inline separator -->
    <Style Selector="Border.separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Margin" Value="0,12"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <!-- ScrollViewer (thin modern scrollbar) -->
    <Style Selector="ScrollViewer /template/ ScrollBar">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="ScrollViewer:pointerover /template/ ScrollBar">
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

  </Application.Styles>
</Application>
