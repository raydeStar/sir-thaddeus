<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="SirThaddeus.UI.Avalonia.ChatInputBar"
             HorizontalAlignment="Stretch"
             Background="Transparent">
  <StackPanel Spacing="8"
              HorizontalAlignment="Stretch">
    <Border x:Name="AttachmentChip"
            IsVisible="False"
            Background="{DynamicResource BackgroundSecondary}"
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderMuted}"
            BorderThickness="1"
            Padding="12,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock x:Name="AttachmentNameText"
                     Text="attachment.txt"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock x:Name="AttachmentMetaText"
                     Text="0 chars"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
        <Button x:Name="RemoveAttachmentButton"
                Grid.Column="1"
                Content="Remove"
                Classes="actionBtn"/>
      </Grid>
    </Border>

    <Border x:Name="ComposerShell"
            Background="{DynamicResource BackgroundSecondary}"
            BorderBrush="{DynamicResource BorderMuted}"
            BorderThickness="1"
            CornerRadius="26"
            Padding="10,10"
          MinWidth="560"
          HorizontalAlignment="Stretch"
            ClipToBounds="True"
            BoxShadow="0 2 12 0 #18000000">
      <Border.Transitions>
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Border.Transitions>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="6"
            MinHeight="52">
        <Button x:Name="AttachFileButton"
                Grid.Column="0"
                Classes="iconButton,composerIconButton"
          Margin="12,0,0,0"
                ToolTip.Tip="Attach file"
              TabIndex="1">
            <ic:SymbolIcon Symbol="Attach"
               FontSize="20"
               Foreground="{DynamicResource TextSecondary}"/>
          </Button>

        <TextBox x:Name="PromptBox"
                 Grid.Column="1"
                 Watermark="Ask Sir Thaddeus to inspect, review, or act..."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="15"
                 MinHeight="48"
                 MaxHeight="160"
                 BorderThickness="0"
                 BorderBrush="Transparent"
                 Background="Transparent"
                 Foreground="{DynamicResource TextPrimary}"
                 CaretBrush="{DynamicResource TextPrimary}"
                 SelectionBrush="{DynamicResource AccentPrimary}"
                 VerticalAlignment="Center"
                 Margin="4,0"
                 Padding="0,12,0,12"
                 TabIndex="0">
          <TextBox.Styles>
            <Style Selector="TextBox">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>
            <Style Selector="TextBox:focus">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>
            <Style Selector="TextBox:pointerover">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>
            <Style Selector="TextBox /template/ Border#PART_BorderElement">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
            </Style>
          </TextBox.Styles>
          <TextBox.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
          </TextBox.Transitions>
        </TextBox>

        <Button x:Name="PttHoldButton"
                Grid.Column="2"
                Classes="iconButton,composerIconButton"
                ToolTip.Tip="Hold to talk"
              TabIndex="2">
            <ic:SymbolIcon Symbol="Mic"
               FontSize="20"
               Foreground="{DynamicResource TextSecondary}"/>
          </Button>

        <Button x:Name="SendButton"
                Grid.Column="3"
                Classes="sendIconButton"
          Margin="0,0,8,0"
                ToolTip.Tip="Send"
              TabIndex="3">
            <ic:SymbolIcon Symbol="Send"
               FontSize="20"
               Foreground="White"/>
          </Button>

        <Button x:Name="StopButton"
                Grid.Column="3"
                Classes="stopIconButton"
                ToolTip.Tip="Stop"
                IsVisible="False"
              TabIndex="3">
            <ic:SymbolIcon Symbol="Stop"
               FontSize="18"
               Foreground="White"/>
          </Button>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
