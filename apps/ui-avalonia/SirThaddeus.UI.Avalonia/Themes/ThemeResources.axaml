<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         SIR THADDEUS — Avalonia Design Tokens  v2
         Modern, refined, trust-forward desktop experience
         ═══════════════════════════════════════════════════════════ -->

    <!-- ── Core Palette (True Dark, High-Contrast) ──────────────── -->
    <SolidColorBrush x:Key="CrustBrush"    Color="#0B0F14"/>
    <SolidColorBrush x:Key="MantleBrush"   Color="#131920"/>
    <SolidColorBrush x:Key="BaseBrush"     Color="#1A2029"/>
    <SolidColorBrush x:Key="Surface0Brush" Color="#252D38"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#2F3946"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#3A4554"/>
    <SolidColorBrush x:Key="Overlay0Brush" Color="#5C6878"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#8490A0"/>
    <SolidColorBrush x:Key="Overlay2Brush" Color="#A1ABB5"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#8B949E"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#C9D1D9"/>
    <SolidColorBrush x:Key="TextBrush"     Color="#E6EDF3"/>

     <!-- ── Landing Redesign Tokens (Dark) ───────────────────────── -->
     <SolidColorBrush x:Key="BackgroundPrimary" Color="#0F0F14"/>
     <SolidColorBrush x:Key="BackgroundSecondary" Color="#1A1A24"/>
     <SolidColorBrush x:Key="BackgroundTertiary" Color="#252532"/>

     <SolidColorBrush x:Key="TextPrimary" Color="#EAEAF0"/>
     <SolidColorBrush x:Key="TextSecondary" Color="#9999AA"/>
     <SolidColorBrush x:Key="TextTertiary" Color="#666677"/>

     <SolidColorBrush x:Key="AccentPrimary" Color="#5B8DEF"/>
     <SolidColorBrush x:Key="AccentHover" Color="#7AA5FF"/>

     <SolidColorBrush x:Key="BorderMuted" Color="#2A2A3A"/>
     <SolidColorBrush x:Key="Danger" Color="#EF4444"/>
     <SolidColorBrush x:Key="Success" Color="#22C55E"/>

    <!-- ── Accent Palette ────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BlueBrush"     Color="#2B8AFF"/>
    <SolidColorBrush x:Key="SapphireBrush" Color="#58A6FF"/>
    <SolidColorBrush x:Key="GreenBrush"    Color="#3FB981"/>
    <SolidColorBrush x:Key="RedBrush"      Color="#E05672"/>
    <SolidColorBrush x:Key="RedLightBrush" Color="#F07A92"/>
    <SolidColorBrush x:Key="YellowBrush"   Color="#D4A94E"/>
    <SolidColorBrush x:Key="MauveBrush"    Color="#A47AEA"/>
    <SolidColorBrush x:Key="PeachBrush"    Color="#E09565"/>
    <SolidColorBrush x:Key="TealBrush"     Color="#42B0BB"/>
    <SolidColorBrush x:Key="LavenderBrush" Color="#B4A0E8"/>

    <!-- ── Semantic Surfaces ─────────────────────────────────────── -->
    <SolidColorBrush x:Key="CardBgBrush"       Color="#151C24"/>
    <SolidColorBrush x:Key="HeroCardBgBrush"   Color="#1A2029"/>
    <SolidColorBrush x:Key="ErrorBgBrush"      Color="#2D1A1A"/>
    <SolidColorBrush x:Key="BlueLightBrush"    Color="#5299FF"/>
    <SolidColorBrush x:Key="BlueBadgeBgBrush"  Color="#0D2E5E"/>
    <SolidColorBrush x:Key="ChatUserBgBrush"   Color="#141A22"/>
    <SolidColorBrush x:Key="ChatAssistBgBrush" Color="#161E28"/>

    <!-- ── Ledger Surfaces ─────────────────────────────────────── -->
    <SolidColorBrush x:Key="LedgerEntryBgBrush"   Color="#1A1F26"/>
    <SolidColorBrush x:Key="ToolActivityBgBrush"   Color="#131920"/>
    <SolidColorBrush x:Key="SpineCommandBrush"     Color="#58A6FF"/>
    <SolidColorBrush x:Key="SpineResultBrush"      Color="#2F3946"/>
    <SolidColorBrush x:Key="SpineToolBrush"        Color="#252D38"/>

    <!-- ── Standard Corner Radii ────────────────────────────────── -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusInput">10</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>

    <!-- ── Spacing / Thickness helpers ──────────────────────────── -->
    <Thickness x:Key="CardPadding">16,14</Thickness>
    <Thickness x:Key="SectionSpacing">0,6</Thickness>

    <!-- ── Settings Navigation Tokens ────────────────────────── -->
    <SolidColorBrush x:Key="SettingsNavBg"          Color="#0D0D12"/>
    <SolidColorBrush x:Key="SettingsContentBg"       Color="#111118"/>
    <SolidColorBrush x:Key="SettingsNavItemHoverBg"  Color="#1A1A26"/>
    <SolidColorBrush x:Key="SettingsNavItemActiveBg" Color="#1E1E2C"/>
    <SolidColorBrush x:Key="SettingsNavAccent"       Color="#5B8DEF"/>
    <SolidColorBrush x:Key="SettingsShellBg"         Color="#10151D"/>
    <SolidColorBrush x:Key="SettingsShellBorder"     Color="#222B37"/>
    <SolidColorBrush x:Key="SettingsCardBg"          Color="#16161F"/>
    <SolidColorBrush x:Key="SettingsCardBorder"      Color="#232330"/>
    <SolidColorBrush x:Key="SettingsStatusCardBg"    Color="#13131B"/>
    <SolidColorBrush x:Key="SettingsMetricBg"        Color="#111723"/>
    <SolidColorBrush x:Key="SettingsMetricBorder"    Color="#293242"/>
    <SolidColorBrush x:Key="SettingsDirtyAccent"     Color="#D4A94E"/>

</ResourceDictionary>
