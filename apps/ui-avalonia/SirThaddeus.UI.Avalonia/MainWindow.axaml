<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SirThaddeus.UI.Avalonia.ViewModels"
        xmlns:local="using:SirThaddeus.UI.Avalonia"
        x:Class="SirThaddeus.UI.Avalonia.MainWindow"
        Width="1060"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        Title="Sir Thaddeus"
        Icon="avares://SirThaddeus.UI.Avalonia/Assets/Icons/sir-thaddeus.ico"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Background="{StaticResource MantleBrush}"
            Padding="16,10"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Button x:Name="ConversationButton" Classes="headerBtn" Click="ConversationButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock x:Name="ConversationTitleText" Text="Conversation"/>
              <TextBlock Text="v" Foreground="{StaticResource Overlay0Brush}"/>
            </StackPanel>
          </Button>

          <Button x:Name="ConnectionStatusButton" Classes="headerBtn" Click="ConnectionStatusButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock x:Name="ConnectionStatusText" Text="Disconnected"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="0">
          <ToggleButton x:Name="ChatTabButton" Content="Chat" IsChecked="True" Classes="viewTab" Click="ViewTab_Click"/>
          <ToggleButton x:Name="BriefingTabButton" Content="Briefing" IsChecked="False" Classes="viewTab" Click="ViewTab_Click"/>
          <ToggleButton x:Name="SettingsTabButton" Content="Settings" IsChecked="False" Classes="viewTab" Click="ViewTab_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Button x:Name="ConnectButton" Content="Connect" Classes="headerBtn" Click="ConnectButton_Click"/>
          <Button x:Name="NewChatButton" Content="New Chat" Classes="headerBtn" Click="NewChatButton_Click"/>
          <Button x:Name="StopAllButton" Content="STOP ALL" Classes="cancelBtn" Click="StopAllButton_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
      <Border x:Name="ConversationDrawer"
              Grid.Column="0"
              Width="280"
              IsVisible="False"
              Background="{StaticResource MantleBrush}"
              BorderBrush="{StaticResource Surface0Brush}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid Grid.Row="0" Margin="12,12,12,8" ColumnDefinitions="*,Auto">
            <TextBlock Text="Conversations" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Classes="headerBtn" Click="CloseConversationDrawerButton_Click"/>
          </Grid>

          <StackPanel Grid.Row="1" Margin="12,0,12,8" Orientation="Horizontal" Spacing="8">
            <Button Content="New Chat" Classes="actionBtn" Click="NewChatButton_Click"/>
            <Button Content="Clear History" Classes="actionBtn" Click="ClearHistoryButton_Click"/>
          </StackPanel>

          <ListBox x:Name="ChatHistoryList"
                   Grid.Row="2"
                   Margin="8,0,8,8"
                   SelectionChanged="ChatHistoryList_SelectionChanged"
                   Background="{StaticResource BaseBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,8" Margin="0,0,0,4" Background="{StaticResource Surface0Brush}" CornerRadius="6">
                  <StackPanel>
                    <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{ReflectionBinding UpdatedLabel}" FontSize="10" Foreground="{StaticResource Overlay0Brush}"/>
                    <TextBlock Text="{ReflectionBinding Preview}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="3"
                     Margin="12,0,12,12"
                     Text="Select a conversation to restore that transcript."
                     FontSize="11"
                     Foreground="{StaticResource Overlay0Brush}"
                     TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid x:Name="ChatView">
          <Grid RowDefinitions="Auto,*" RowSpacing="0">
            <Border x:Name="ChatActionBar"
                    Background="{StaticResource MantleBrush}"
                    IsVisible="False"
                    Padding="12,8"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CopyLastAssistantButton" Content="Copy Last" Classes="actionBtn" Click="CopyLastAssistantButton_Click"/>
                <Button x:Name="RetryLastPromptButton" Content="Retry Last" Classes="actionBtn" Click="RetryLastPromptButton_Click"/>
                <Button x:Name="ReadAloudButton" Content="Read Aloud" Classes="actionBtn" Click="ReadAloudButton_Click"/>
                <Button x:Name="SourcesButton" Content="Sources" Classes="actionBtn" Click="ShowSourcesButton_Click"/>
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          x:Name="ChatScroller"
                          Background="{StaticResource BaseBrush}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <Grid>
                <StackPanel x:Name="EmptyHero"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,60,0,0">
                  <TextBlock Text="Your AI. Your Rules."
                             FontSize="28"
                             FontWeight="Bold"
                             Foreground="{StaticResource TextBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,8"/>
                  <TextBlock Text="A local-first copilot that only acts with explicit permission."
                             FontSize="14"
                             Foreground="{StaticResource Subtext0Brush}"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,24"/>
                  <TextBlock Text="Hold to talk (Ctrl+Alt+M)"
                             FontSize="13"
                             Foreground="{StaticResource Overlay0Brush}"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,4"/>
                  <TextBlock Text="Command Palette (Ctrl+Space)"
                             FontSize="13"
                             Foreground="{StaticResource Overlay0Brush}"
                             HorizontalAlignment="Center"/>
                </StackPanel>

                <ItemsControl x:Name="ChatMessagesList" Margin="16,16,16,60" Background="Transparent">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageItem">
                      <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="3"/>
                          <ColumnDefinition Width="16"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Spines for role visual distinction -->
                        <Border Grid.Column="0" Background="{StaticResource MauveBrush}" CornerRadius="4" VerticalAlignment="Stretch" IsVisible="{Binding IsAssistant}"/>
                        <Border Grid.Column="0" Background="{StaticResource BlueBrush}" CornerRadius="4" VerticalAlignment="Stretch" IsVisible="{Binding IsUser}"/>
                        <Border Grid.Column="0" Background="{StaticResource YellowBrush}" CornerRadius="4" VerticalAlignment="Stretch" IsVisible="{Binding IsSystem}"/>

                        <StackPanel Grid.Column="2">
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Spacing="8">
                            <TextBlock Text="{Binding AuthorLabel}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                            <TextBlock Text="{Binding TimeDisplay}" FontSize="11" Foreground="{StaticResource Overlay0Brush}" VerticalAlignment="Center"/>
                          </StackPanel>
                          <TextBox Text="{Binding Content}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   Padding="0"
                                   TextWrapping="Wrap"
                                   IsReadOnly="True"
                                   IsTabStop="False"
                                   Cursor="IBeam"
                                   SelectionBrush="{StaticResource Surface1Brush}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>

        <Grid x:Name="BriefingView" IsVisible="False" Background="{StaticResource BaseBrush}">
          <Grid ColumnDefinitions="260,*,320">
            <Border Grid.Column="0"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,1,0">
              <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="16,16,16,12" Spacing="4">
                  <TextBlock Text="Briefing History" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock x:Name="BriefingHistoryHintText"
                             Text="Deep-dive results from this conversation appear here."
                             FontSize="11"
                             Foreground="{StaticResource Overlay0Brush}"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox Grid.Row="1"
                         x:Name="BriefingHistoryList"
                         Margin="10,0,10,10"
                         SelectionChanged="BriefingHistoryList_SelectionChanged"
                         Background="{StaticResource BaseBrush}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,6" Padding="10,8" Background="{StaticResource Surface0Brush}" CornerRadius="6">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Background="{ReflectionBinding ConfidenceBrush}" CornerRadius="999" Padding="8,2">
                              <TextBlock Text="{ReflectionBinding ConfidenceLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BaseBrush}"/>
                            </Border>
                          </Grid>
                          <TextBlock Text="{ReflectionBinding StatusLine}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap" MaxLines="2"/>
                          <TextBlock Text="{ReflectionBinding UpdatedLabel}" FontSize="10" Foreground="{StaticResource Overlay0Brush}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="24,20,20,20" MaxWidth="760" Spacing="14">
                <Border Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="12,10">
                  <TextBlock x:Name="BriefingStatusText"
                             Text="No briefing loaded yet. Ask for a place or product deep dive in chat."
                             FontSize="12"
                             Foreground="{StaticResource Subtext0Brush}"
                             TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="BriefingEmptyState"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="24,22">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="No briefing loaded"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Use chat to ask about a business, place, or product. Structured briefing output will appear here when the runtime returns it."
                               MaxWidth="480"
                               FontSize="12"
                               Foreground="{StaticResource Overlay0Brush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                  </StackPanel>
                </Border>

                <Border x:Name="BriefingHeroCard"
                        IsVisible="False"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="16,14">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock x:Name="BriefingHeroTitleText" Text="Briefing title" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BriefingHeroStatusText" Text="Status line" FontSize="14" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Border x:Name="BriefingConfidenceBadge" Background="{StaticResource Surface0Brush}" CornerRadius="999" Padding="12,6" VerticalAlignment="Top">
                        <TextBlock x:Name="BriefingConfidenceText" Text="UNKNOWN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BaseBrush}"/>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <Border Background="{StaticResource BaseBrush}" CornerRadius="8" Padding="10,8" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Checked" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                          <TextBlock x:Name="BriefingLastCheckedText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Background="{StaticResource BaseBrush}" CornerRadius="8" Padding="10,8" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Hours" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                          <TextBlock x:Name="BriefingClosesText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Name="BriefingWebsiteButton" Content="Website" Classes="actionBtn" IsEnabled="False" Click="BriefingWebsiteButton_Click"/>
                      <Button x:Name="BriefingDirectionsButton" Content="Directions" Classes="actionBtn" IsEnabled="False" Click="BriefingDirectionsButton_Click"/>
                      <Button x:Name="BriefingCopyPhoneButton" Content="Copy Phone" Classes="actionBtn" IsEnabled="False" Click="BriefingCopyPhoneButton_Click"/>
                      <Button x:Name="BriefingCopyAddressButton" Content="Copy Address" Classes="actionBtn" IsEnabled="False" Click="BriefingCopyAddressButton_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <ItemsControl x:Name="BriefingCardsList" IsVisible="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,12"
                              Padding="14,12"
                              Background="{StaticResource MantleBrush}"
                              BorderBrush="{StaticResource Surface0Brush}"
                              BorderThickness="1"
                              CornerRadius="{StaticResource RadiusMd}">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{ReflectionBinding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding TypeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                          </Grid>
                          <ItemsControl ItemsSource="{ReflectionBinding Bullets}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                  <TextBlock Text="- " FontSize="12" Foreground="{StaticResource Overlay0Brush}"/>
                                  <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Subtext1Brush}" TextWrapping="Wrap" MaxWidth="620"/>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{ReflectionBinding SourceSummary}" FontSize="11" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="BriefingAuditSection"
                        IsVisible="False"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}">
                  <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Audit Trail" Margin="14,12,14,4" FontSize="13" FontWeight="SemiBold"/>
                    <ListBox x:Name="BriefingAuditList" Grid.Row="1" Margin="10,0,10,10" Background="Transparent">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,6" Padding="10,8" Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{ReflectionBinding StepLabel}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{ReflectionBinding TimestampLabel}" FontSize="10" Foreground="{StaticResource Overlay0Brush}"/>
                              </Grid>
                              <TextBlock Text="{ReflectionBinding Detail}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap"/>
                              <TextBlock Text="{ReflectionBinding SourceSummary}" FontSize="10" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="1,0,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,18,16,18" Spacing="14">
                  <TextBlock Text="Quick Info" FontSize="13" FontWeight="SemiBold"/>

                  <Border Background="{StaticResource BaseBrush}"
                          CornerRadius="{StaticResource RadiusMd}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1"
                          Padding="12,10">
                    <StackPanel Spacing="8">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Address" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                        <TextBlock x:Name="BriefingAddressText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Phone" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                        <TextBlock x:Name="BriefingPhoneText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Query" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                        <TextBlock x:Name="BriefingQueryText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border x:Name="BriefingMapSection"
                          IsVisible="False"
                          Background="{StaticResource BaseBrush}"
                          CornerRadius="{StaticResource RadiusMd}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1"
                          Padding="12,10">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Map" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock x:Name="BriefingMapLabelText" Text="Map" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock x:Name="BriefingMapCoordsText" Text="-" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap"/>
                      <TextBlock Text="Coordinates are shown now; platform map embedding can land later without changing the contract."
                                 FontSize="10"
                                 Foreground="{StaticResource Overlay0Brush}"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>

                  <Border x:Name="BriefingSourcesSection"
                          IsVisible="False"
                          Background="{StaticResource BaseBrush}"
                          CornerRadius="{StaticResource RadiusMd}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                      <TextBlock Grid.Row="0" Text="Sources" Margin="12,10,12,4" FontSize="13" FontWeight="SemiBold"/>
                      <ListBox x:Name="BriefingSourcesList" Grid.Row="1" Margin="8,0,8,8" Background="Transparent">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="10,8" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="{ReflectionBinding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                  <TextBlock Text="{ReflectionBinding Meta}" FontSize="10" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Open"
                                        Classes="actionBtn"
                                        Tag="{ReflectionBinding Url}"
                                        Click="BriefingSourceOpenButton_Click"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="SettingsView" IsVisible="False" Background="{StaticResource BaseBrush}">
          <Grid RowDefinitions="Auto,*" RowSpacing="0">
            <Border x:Name="SettingsHeaderBar"
                    x:CompileBindings="False"
                    Background="{StaticResource MantleBrush}"
                    Padding="12,8"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Subtext0Brush}"/>
                  <TextBlock Text="Unsaved settings will not reach the runtime until you save."
                             FontSize="11"
                             Foreground="{StaticResource Overlay0Brush}"
                             IsVisible="{Binding IsDirty}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="ReloadSettingsButton"
                        Content="Reload"
                        Classes="actionBtn"
                        Click="ReloadSettingsButton_Click"/>
                <Button Grid.Column="2"
                        x:Name="SaveSettingsButton"
                        Content="Save"
                        Classes="actionBtn"
                        IsEnabled="{Binding IsDirty}"
                        Click="SaveSettingsButton_Click"/>
              </Grid>
            </Border>

            <TabControl Grid.Row="1" x:Name="SettingsTabControl" TabStripPlacement="Left" Padding="0" Background="Transparent" SelectionChanged="SettingsTabControl_SelectionChanged"> 
            
            <TabItem Header="General">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,32,24" MaxWidth="720" Spacing="14">
                  <TextBlock Text="RUNTIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>

                  <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="Runtime URL" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="RuntimeUrlBox"
                             Text="http://127.0.0.1:5378"
                             Classes="chatInput"
                             FontSize="12"
                             Padding="8,6"/>
                    <Button Grid.Column="2" Content="Connect" Classes="actionBtn" Click="ConnectButton_Click"/>
                  </Grid>

                  <TextBlock x:Name="SettingsRuntimeText" Text="Runtime: not connected" FontSize="13" Foreground="{StaticResource Subtext0Brush}"/>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StartRuntimeButton" Content="Start Local Runtime" Classes="actionBtn" Click="StartRuntimeButton_Click"/>
                    <Button x:Name="StopRuntimeButton" Content="Stop Managed Runtime" Classes="actionBtn" Click="StopRuntimeButton_Click"/>
                  </StackPanel>

                  <TextBlock x:Name="RuntimeLaunchStateText" Text="Managed runtime: not running" FontSize="12" Foreground="{StaticResource Overlay0Brush}"/>

                  <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="0,8"/>

                  <StackPanel x:Name="ConstraintsPanel" Spacing="14" x:CompileBindings="False">
                    <TextBlock Text="RUNTIME CONSTRAINTS &amp; TOOL BUDGETS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource RedBrush}"/>
                    <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                      <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="10" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Tool Calls Per Turn" FontSize="12" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding MaxToolCallsPerTurn}" Minimum="1" Maximum="100" HorizontalAlignment="Left" Width="140" FontSize="12" Padding="8,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Tool Calls Per Session" FontSize="12" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxToolCallsPerSession}" Minimum="1" Maximum="10000" HorizontalAlignment="Left" Width="140" FontSize="12" Padding="8,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Web Pulls Per Turn" FontSize="12" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaxWebPullsPerTurn}" Minimum="0" Maximum="25" HorizontalAlignment="Left" Width="140" FontSize="12" Padding="8,6"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Max File Ops Per Minute" FontSize="12" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MaxFileOpsPerMinute}" Minimum="0" Maximum="600" HorizontalAlignment="Left" Width="140" FontSize="12" Padding="8,6"/>
                      </Grid>
                    </Border>
                  </StackPanel>

                  <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="0,8"/>

                  <TextBlock Text="INTERACTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauveBrush}"/>
                  <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                      <CheckBox x:Name="SendOnEnterCheckBox" Content="Send on Enter (Shift+Enter newline)" Click="SendOnEnterCheckBox_Click"/>
                      <CheckBox x:Name="AutoSwitchPermissionsCheckBox" Content="Auto-switch to Permissions tab when approval is requested" Click="AutoSwitchPermissionsCheckBox_Click"/>
                      <CheckBox x:Name="AutoConnectCheckBox" Content="Auto-connect on startup" Click="AutoConnectCheckBox_Click"/>
                      <CheckBox x:Name="AutoStartRuntimeCheckBox" Content="Auto-start local runtime if unavailable" Click="AutoStartRuntimeCheckBox_Click"/>
                      <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to tray on close" Click="MinimizeToTrayCheckBox_Click"/>
                      <TextBlock x:Name="TraySupportText" Text="Tray support is being detected..." FontSize="12" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="STATUS + SHORTCUTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                  <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Runtime status lives in the header connection drawer." FontSize="12" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                      <TextBlock Text="Tabs: Ctrl+1 Chat, Ctrl+2 Briefing, Ctrl+3 Settings." FontSize="12" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                      <TextBlock Text="Voice: Hold Talk or use Ctrl+Alt+M. On Windows the hotkey is global, and Ctrl+Alt+Esc cancels voice playback, transcription, or an active run. Other platforms keep the UI hooks in place while native capture support catches up. Read aloud is currently Windows-only." FontSize="12" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem x:Name="LlmsTabItem" Header="LLMs" x:CompileBindings="False">
              <ScrollViewer x:Name="LlmsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,32,24" MaxWidth="720" Spacing="14">
                  <TextBlock Text="PRIMARY REASONING ENGINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                  
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Presets:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Overlay0Brush}"/>
                    <Button x:Name="LmStudioPresetBtn" Content="LM Studio" Classes="actionBtn" Tag="http://localhost:1234"/>
                    <Button x:Name="OllamaPresetBtn" Content="Ollama" Classes="actionBtn" Tag="http://localhost:11434"/>
                    <Button x:Name="OpenAiPresetBtn" Content="OpenAI" Classes="actionBtn" Tag="https://api.openai.com"/>
                  </StackPanel>

                  <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LlmBaseUrl}" Classes="chatInput" FontSize="12" Padding="8,6"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Model ID" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LlmModel}" Classes="chatInput" FontSize="12" Padding="8,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Discovery" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Content="Refresh Models" Classes="actionBtn" Click="RefreshPrimaryModelsButton_Click"/>
                      <TextBlock Text="Queries GET /v1/models on the current base URL." FontSize="11" Foreground="{StaticResource Overlay0Brush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Discovered Models" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailablePrimaryModels}" SelectedItem="{Binding LlmModel}" HorizontalAlignment="Stretch"/>
                  </Grid>

                  <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="0,8"/>

                  <TextBlock Text="GATEKEEPER (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauveBrush}"/>
                  <TextBlock Text="Used for faster local verification of tools or small tasks." FontSize="11" Foreground="{StaticResource Overlay0Brush}"/>
                  
                  <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gatekeeper Base URL" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GatekeeperBaseUrl}" Classes="chatInput" FontSize="12" Padding="8,6"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Gatekeeper Model ID" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GatekeeperModelId}" Classes="chatInput" FontSize="12" Padding="8,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Effective URL" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EffectiveGatekeeperBaseUrl}" FontSize="12" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Discovery" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Content="Refresh Gatekeeper" Classes="actionBtn" Click="RefreshGatekeeperModelsButton_Click"/>
                      <TextBlock Text="Falls back to the primary base URL when left blank." FontSize="11" Foreground="{StaticResource Overlay0Brush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Discovered Models" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AvailableGatekeeperModels}" SelectedItem="{Binding GatekeeperModelId}" HorizontalAlignment="Stretch"/>
                  </Grid>

                  <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="0,8"/>

                  <TextBlock Text="PARAMETERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                  <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Tokens" FontSize="12" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding LlmMaxTokens}" Minimum="1" Maximum="32000" FontSize="12" Padding="8,6" HorizontalAlignment="Left" Width="140"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Temperature" FontSize="12" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding LlmTemperature}" Minimum="0.0" Maximum="2.0" Increment="0.1" FormatString="F2" FontSize="12" Padding="8,6" HorizontalAlignment="Left" Width="140"/>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AudioTabItem" Header="Audio &amp; Voice" x:CompileBindings="False">
              <ScrollViewer x:Name="AudioScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,32,24" MaxWidth="720" Spacing="14">
                  <TextBlock Text="AUDIO DEVICES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                  <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Choose which local devices push-to-talk capture and read-aloud playback should use." FontSize="11" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                      <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Input Device" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding AvailableInputDevices}"
                                  SelectedItem="{Binding SelectedInputDevice}"
                                  HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Output Device" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding AvailableOutputDevices}"
                                  SelectedItem="{Binding SelectedOutputDevice}"
                                  HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Input Gain" FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                          <NumericUpDown Value="{Binding InputGain}" Minimum="0.0" Maximum="2.0" Increment="0.1" FormatString="F1" Width="140" FontSize="12" Padding="8,6"/>
                          <TextBlock Text="{Binding InputGain, StringFormat={}{0:F1}x}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Overlay0Brush}"/>
                        </StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh Devices" Classes="actionBtn" Click="RefreshAudioDevicesButton_Click"/>
                        <TextBlock Text="Refresh after plugging in or removing a headset, microphone, or speaker." FontSize="11" Foreground="{StaticResource Overlay0Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="0,8"/>

                  <TextBlock Text="VOICE PIPELINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PeachBrush}"/>
                  <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                      <CheckBox Content="Enable Local VoiceHost" IsChecked="{Binding VoiceHostEnabled}" FontSize="12"/>
                      <StackPanel Spacing="8" IsVisible="{Binding VoiceHostEnabled}">
                        <TextBlock Text="VoiceHost URL" FontSize="12" Foreground="{StaticResource Overlay0Brush}"/>
                        <TextBox Text="{Binding VoiceHostBaseUrl}" Classes="chatInput" FontSize="12" Padding="8,6"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Refresh Health" Classes="actionBtn" Click="RefreshVoiceHostHealthButton_Click"/>
                          <TextBlock Text="Polls the local /health endpoint while this tab is open." FontSize="11" Foreground="{StaticResource Overlay0Brush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VoiceHostStatusText}" FontSize="12" FontWeight="SemiBold"/>
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="ASR Ready" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VoiceHostAsrReady}" FontSize="12"/>
                          <TextBlock Grid.Row="2" Grid.Column="0" Text="TTS Ready" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VoiceHostTtsReady}" FontSize="12"/>
                          <TextBlock Grid.Row="3" Grid.Column="0" Text="Version" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VoiceHostVersion}" FontSize="12"/>
                        </Grid>
                        <TextBlock Text="{Binding VoiceHostMessage}" FontSize="11" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="0,8"/>

                  <TextBlock Text="TEXT-TO-SPEECH FORMAT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LavenderBrush}"/>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                     <TextBlock Text="TTS Engine" FontSize="12" VerticalAlignment="Center"/>
                     <ComboBox Grid.Column="1" ItemsSource="{Binding TtsEngineOptions}" SelectedItem="{Binding VoiceTtsEngine}" HorizontalAlignment="Stretch"/>
                  </Grid>
                  <TextBlock Text="{Binding VoiceSectionLabel}" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding VoiceSectionDescription}" FontSize="11" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                  <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="6" IsVisible="{Binding IsWindowsEngine}">
                        <TextBlock Text="Windows uses the system speech synthesizer. Voice id and model id are optional here." FontSize="12" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Spacing="8" IsVisible="{Binding IsPiperEngine}">
                        <TextBlock Text="Piper Voice" FontSize="12" Foreground="{StaticResource Overlay0Brush}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <ComboBox ItemsSource="{Binding AvailablePiperVoices}" SelectedItem="{Binding SelectedPiperVoice}" HorizontalAlignment="Stretch"/>
                          <Button Grid.Column="1" Content="Refresh Voices" Classes="actionBtn" Click="RefreshTtsVoicesButton_Click"/>
                        </Grid>
                        <TextBlock Text="Choose an installed Piper voice, or pick a '(download)' entry to fetch it through VoiceHost." FontSize="11" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PiperVoiceDownloadStatus}" FontSize="11" Foreground="{StaticResource LavenderBrush}" TextWrapping="Wrap" IsVisible="{Binding IsPiperStatusVisible}"/>
                        <TextBlock Text="Piper Model ID (Optional)" FontSize="12" Foreground="{StaticResource Overlay0Brush}"/>
                        <TextBox Text="{Binding VoiceTtsModelId}" Classes="chatInput" FontSize="12" Padding="8,6"/>
                      </StackPanel>
                      <StackPanel Spacing="8" IsVisible="{Binding IsKokoroEngine}">
                        <TextBlock Text="Kokoro Voice" FontSize="12" Foreground="{StaticResource Overlay0Brush}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <ComboBox ItemsSource="{Binding AvailableKokoroVoices}" SelectedItem="{Binding SelectedKokoroVoice}" HorizontalAlignment="Stretch"/>
                          <Button Grid.Column="1" Content="Refresh Voices" Classes="actionBtn" Click="RefreshTtsVoicesButton_Click"/>
                        </Grid>
                        <TextBlock Text="Installed Kokoro voice packs are discovered locally. Leaving the saved voice blank falls back to the active personality preference." FontSize="11" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Kokoro Model ID (Optional)" FontSize="12" Foreground="{StaticResource Overlay0Brush}"/>
                        <TextBox Text="{Binding VoiceTtsModelId}" Classes="chatInput" FontSize="12" Padding="8,6"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="0,8"/>
                  <TextBlock Text="YOUTUBE INTEGRATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource RedBrush}"/>
                  <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                       <TextBlock Grid.Row="0" Grid.Column="0" Text="ASR Provider" FontSize="12" VerticalAlignment="Center"/>
                       <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding YouTubeAsrProviderOptions}" SelectedItem="{Binding YouTubeAsrProvider}" HorizontalAlignment="Stretch"/>
                       
                       <TextBlock Grid.Row="1" Grid.Column="0" Text="Model ID / Size" FontSize="12" VerticalAlignment="Center"/>
                       <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding YouTubeAsrModelId}" Classes="chatInput" FontSize="12" Padding="8,6"/>
                       
                       <TextBlock Grid.Row="2" Grid.Column="0" Text="Language Hint" FontSize="12" VerticalAlignment="Center"/>
                       <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding YouTubeLanguageHint}" Classes="chatInput" FontSize="12" Padding="8,6"/>

                       <TextBlock Grid.Row="3" Grid.Column="0" Text="Drafting Tone" FontSize="12" VerticalAlignment="Center"/>
                       <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding YouTubeDraftToneOptions}" SelectedItem="{Binding YouTubeDraftTone}" HorizontalAlignment="Stretch"/>

                       <TextBlock Grid.Row="4" Grid.Column="0" Text="Keep Audio Files" FontSize="12" VerticalAlignment="Center"/>
                       <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding YouTubeKeepAudio}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem x:Name="PermissionsTabItem" Header="Permissions" x:CompileBindings="False">
              <Grid x:Name="PermissionsGrid" Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                <TextBlock x:Name="PermissionSummaryText"
                           Text="No pending permission requests."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <Border Grid.Row="1"
                        Background="{StaticResource MantleBrush}"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="16,12"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1">
                  <TextBox x:Name="PermissionPayloadBox"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           Background="Transparent"
                           Foreground="{StaticResource Subtext1Brush}"
                           BorderThickness="0"
                           FontSize="12"
                           TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                  <Button x:Name="ApprovePermissionButton" Content="Approve"
                          Classes="approveBtn" IsEnabled="False"
                          Click="ApprovePermissionButton_Click"/>
                  <Button x:Name="DenyPermissionButton" Content="Deny"
                          Classes="denyBtn" IsEnabled="False"
                          Click="DenyPermissionButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="12">
                  <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="0,12"/>
                  <TextBlock Text="MCP PERMISSION POLICIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource YellowBrush}"/>
                  <TextBlock Text="Require confirmation before the local agent takes action in these capability groups." FontSize="11" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                  
                  <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="16" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="200,*" RowSpacing="12">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Developer Override" FontSize="12" VerticalAlignment="Center"/>
                      <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding McpDeveloperOverride}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="none"/>
                        <ComboBoxItem Content="ask"/>
                        <ComboBoxItem Content="always"/>
                        <ComboBoxItem Content="off"/>
                      </ComboBox>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen Capture" FontSize="12" VerticalAlignment="Center"/>
                      <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding McpScreen}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="ask"/>
                        <ComboBoxItem Content="always"/>
                        <ComboBoxItem Content="off"/>
                      </ComboBox>

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="File System (Read &amp; Write)" FontSize="12" VerticalAlignment="Center"/>
                      <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding McpFiles}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="ask"/>
                        <ComboBoxItem Content="always"/>
                        <ComboBoxItem Content="off"/>
                      </ComboBox>

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="System Commands" FontSize="12" VerticalAlignment="Center"/>
                      <ComboBox Grid.Row="3" Grid.Column="1" SelectedItem="{Binding McpSystem}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="ask"/>
                        <ComboBoxItem Content="always"/>
                        <ComboBoxItem Content="off"/>
                      </ComboBox>

                      <TextBlock Grid.Row="4" Grid.Column="0" Text="Web Navigation &amp; Search" FontSize="12" VerticalAlignment="Center"/>
                      <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding McpWeb}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="ask"/>
                        <ComboBoxItem Content="always"/>
                        <ComboBoxItem Content="off"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
            </TabItem>

            <TabItem x:Name="AuditTabItem" Header="Audit">
              <Grid RowDefinitions="Auto,*" RowSpacing="0">
                <Border Background="{StaticResource MantleBrush}"
                        Padding="12,8"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshAuditButton" Content="Refresh"
                            Classes="actionBtn" Click="RefreshAuditButton_Click"/>
                  </StackPanel>
                </Border>
                <ListBox x:Name="AuditList" Grid.Row="1"
                         Background="{StaticResource BaseBrush}"
                         Foreground="{StaticResource TextBrush}"/>
              </Grid>
            </TabItem>

            <TabItem x:Name="MemoryTabItem" Header="Memory">
              <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="MemoryFilterBox"
                           Watermark="Filter memory..."
                           Classes="chatInput"
                           FontSize="12"
                           Padding="8,6"/>
                  <Button Grid.Column="1"
                          x:Name="RefreshMemoryButton"
                          Content="Refresh"
                          Classes="actionBtn"
                          Click="RefreshMemoryButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           x:Name="MemoryStatusText"
                           Text="Memory: not loaded"
                           FontSize="12"
                           Foreground="{StaticResource Overlay0Brush}"/>

                <TabControl Grid.Row="2" Background="Transparent" Padding="0,10,0,0">
                  <TabItem Header="Facts">
                    <DataGrid x:Name="MemoryFactsList" AutoGenerateColumns="False" IsReadOnly="False" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" GridLinesVisibility="All" CellEditEnded="MemoryFactsList_CellEditEnded">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Subject" Binding="{ReflectionBinding Subject}" Width="120" />
                        <DataGridTextColumn Header="Predicate" Binding="{ReflectionBinding Predicate}" Width="100" />
                        <DataGridTextColumn Header="Object" Binding="{ReflectionBinding Object}" Width="*" />
                        <DataGridTextColumn Header="Confidence" Binding="{ReflectionBinding Confidence}" Width="80" />
                        <DataGridTextColumn Header="Profile" Binding="{ReflectionBinding ProfileId}" Width="100" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Events">
                    <DataGrid x:Name="MemoryEventsList" AutoGenerateColumns="False" IsReadOnly="False" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" GridLinesVisibility="All" CellEditEnded="MemoryEventsList_CellEditEnded">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{ReflectionBinding Type}" Width="120" />
                        <DataGridTextColumn Header="Title" Binding="{ReflectionBinding Title}" Width="*" />
                        <DataGridTextColumn Header="Summary" Binding="{ReflectionBinding Summary}" Width="150" />
                        <DataGridTextColumn Header="Confidence" Binding="{ReflectionBinding Confidence}" Width="80" />
                        <DataGridTextColumn Header="Profile" Binding="{ReflectionBinding ProfileId}" Width="100" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Chunks">
                    <DataGrid x:Name="MemoryChunksList" AutoGenerateColumns="False" IsReadOnly="False" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" GridLinesVisibility="All" CellEditEnded="MemoryChunksList_CellEditEnded">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Source Type" Binding="{ReflectionBinding SourceType}" Width="100" />
                        <DataGridTextColumn Header="Source Ref" Binding="{ReflectionBinding SourceRef}" Width="120" />
                        <DataGridTextColumn Header="Text" Binding="{ReflectionBinding Text}" Width="*" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Nuggets">
                    <DataGrid x:Name="MemoryNuggetsList" AutoGenerateColumns="False" IsReadOnly="False" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" GridLinesVisibility="All" CellEditEnded="MemoryNuggetsList_CellEditEnded">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Text" Binding="{ReflectionBinding Text}" Width="*" />
                        <DataGridTextColumn Header="Tags" Binding="{ReflectionBinding Tags}" Width="120" />
                        <DataGridTextColumn Header="Weight" Binding="{ReflectionBinding Weight}" Width="80" />
                        <DataGridTextColumn Header="Pin Lvl" Binding="{ReflectionBinding PinLevel}" Width="60" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                </TabControl>
              </Grid>
            </TabItem>

            <TabItem x:Name="ProfilesTabItem" Header="Profiles">
              <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Button x:Name="RefreshProfilesButton"
                          Content="Refresh"
                          Classes="actionBtn"
                          Click="RefreshProfilesButton_Click"/>
                  <TextBlock Grid.Column="1"
                             x:Name="ProfilesStatusText"
                             Text="Profiles: not loaded"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource Overlay0Brush}"/>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                  <Border Background="{StaticResource MantleBrush}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource RadiusMd}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="14">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Memory Profiles" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Your user and person memory cards. Select one to edit, delete, or make active."
                                   FontSize="11"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemHeight="34" ItemWidth="128">
                        <Button x:Name="AddProfileButton"
                                Content="Add"
                                Classes="actionBtn"
                                Click="AddProfileButton_Click"/>
                        <Button x:Name="EditProfileButton"
                                Content="Edit"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="EditProfileButton_Click"/>
                        <Button x:Name="DeleteProfileButton"
                                Content="Delete"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="DeleteProfileButton_Click"/>
                        <Button x:Name="SetActiveProfileButton"
                                Content="Set Active"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="SetActiveProfileButton_Click"/>
                      </WrapPanel>
                      <DataGrid Grid.Row="2"
                                x:Name="ProfilesList"
                                SelectionChanged="ProfilesList_SelectionChanged"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                GridLinesVisibility="All">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Profile" Binding="{ReflectionBinding DisplayName}" Width="160"/>
                          <DataGridTextColumn Header="Details" Binding="{ReflectionBinding Meta}" Width="*"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1"
                          Background="{StaticResource MantleBrush}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource RadiusMd}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="14">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Personalities" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Assistant behavior profiles. Select one to edit, delete, or make active."
                                   FontSize="11"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemHeight="34" ItemWidth="128">
                        <Button x:Name="AddPersonalityButton"
                                Content="Add"
                                Classes="actionBtn"
                                Click="AddPersonalityButton_Click"/>
                        <Button x:Name="EditPersonalityButton"
                                Content="Edit"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="EditPersonalityButton_Click"/>
                        <Button x:Name="DeletePersonalityButton"
                                Content="Delete"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="DeletePersonalityButton_Click"/>
                        <Button x:Name="SetActivePersonalityButton"
                                Content="Set Active"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="SetActivePersonalityButton_Click"/>
                      </WrapPanel>
                      <DataGrid Grid.Row="2"
                                x:Name="PersonalitiesList"
                                SelectionChanged="PersonalitiesList_SelectionChanged"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                GridLinesVisibility="All">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Personality" Binding="{ReflectionBinding DisplayName}" Width="160"/>
                          <DataGridTextColumn Header="Details" Binding="{ReflectionBinding Meta}" Width="*"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </Grid>
                  </Border>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Add opens a starter JSON document. Edit loads the current JSON. Active items are selected automatically when the tab refreshes."
                           FontSize="12"
                           Foreground="{StaticResource Overlay0Brush}"
                           TextWrapping="Wrap"/>
              </Grid>
            </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </Grid>

      <Border x:Name="ActionDrawer"
              Grid.Column="2"
              Width="320"
              IsVisible="False"
              Background="{StaticResource MantleBrush}"
              BorderBrush="{StaticResource Surface0Brush}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" Margin="12,12,12,8" ColumnDefinitions="*,Auto">
            <TextBlock Text="Activity" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Classes="headerBtn" Click="CloseActionDrawerButton_Click"/>
          </Grid>

          <Border Grid.Row="1"
                  Margin="12,0,12,8"
                  Background="{StaticResource BaseBrush}"
                  CornerRadius="{StaticResource RadiusMd}"
                  BorderBrush="{StaticResource Surface0Brush}"
                  BorderThickness="1"
                  Padding="10,8">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
              <Border Background="{StaticResource Surface0Brush}" CornerRadius="999" Padding="8,3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border x:Name="ActionConnectionDot"
                          Width="7"
                          Height="7"
                          CornerRadius="999"
                          Background="{StaticResource Overlay0Brush}"
                          VerticalAlignment="Center"/>
                  <TextBlock x:Name="ActionConnectionStateText"
                             Text="Disconnected"
                             FontSize="11"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="1"
                         Text="|"
                         Foreground="{StaticResource Overlay0Brush}"
                         VerticalAlignment="Center"/>
              <TextBlock x:Name="ActionRuntimeStateText"
                         Grid.Column="2"
                         Text="Runtime: unknown"
                         FontSize="11"
                         Foreground="{StaticResource Overlay0Brush}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Grid.Row="2" Margin="12,0,12,12" Background="{StaticResource BaseBrush}" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Text="Recent Activity" Margin="10,8,10,6" FontWeight="SemiBold" FontSize="12"/>
              <ListBox x:Name="ActionAuditPreviewList" Grid.Row="1" Margin="8,0,8,8" Background="Transparent"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" x:Name="InputBar"
            Background="{StaticResource MantleBrush}"
            Padding="16,10"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,1,0,0">
      <StackPanel Spacing="8">
        <Border x:Name="AttachmentChip"
                IsVisible="False"
                Background="{StaticResource Surface0Brush}"
                CornerRadius="{StaticResource RadiusMd}"
                Padding="10,6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="2">
              <TextBlock x:Name="AttachmentNameText" Text="attachment.txt" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock x:Name="AttachmentMetaText" Text="0 chars" FontSize="11" Foreground="{StaticResource Overlay0Brush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Remove" Classes="actionBtn" Click="RemoveAttachmentButton_Click"/>
          </Grid>
        </Border>

        <Border Background="{StaticResource BaseBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}"
                Padding="10,8"
                IsVisible="False">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border x:Name="PttStateBadge"
                    Background="{StaticResource Surface0Brush}"
                    CornerRadius="999"
                    Padding="10,4"
                    VerticalAlignment="Top">
              <TextBlock x:Name="PttStateText"
                         Text="READY"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{StaticResource BaseBrush}"/>
            </Border>

            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock x:Name="PttStatusText"
                         Text="Voice ready. Hold Talk or press Ctrl+Alt+M."
                         FontSize="11"
                         Foreground="{StaticResource TextBrush}"
                         TextWrapping="Wrap"/>
              <TextBlock x:Name="PttDetailText"
                         Text="Preparing voice controls."
                         FontSize="10"
                         Foreground="{StaticResource Overlay0Brush}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Button x:Name="AttachFileButton"
                  Grid.Column="0"
                  Content="+"
                  Width="38"
                  Classes="actionBtn"
                  Click="AttachFileButton_Click"/>
          <TextBox x:Name="PromptBox"
                   Grid.Column="1"
                   Watermark="Type a message... (Shift+Enter for new line)"
                   AcceptsReturn="True"
                   MinHeight="38"
                   MaxHeight="120"
                   TextWrapping="Wrap"
                   KeyDown="PromptBox_KeyDown"
                   TextChanged="PromptBox_TextChanged"
                   Classes="chatInput"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
            <Button x:Name="PttHoldButton"
                    Content="Hold"
                    Classes="actionBtn"
                    PointerPressed="PttHoldButton_PointerPressed"
                    PointerReleased="PttHoldButton_PointerReleased"
                    PointerCaptureLost="PttHoldButton_PointerCaptureLost"/>
            <Button x:Name="SendButton" Content="Send" Classes="sendBtn" Click="SendButton_Click"/>
            <Button x:Name="StopButton" Content="STOP" Classes="cancelBtn" Click="StopButton_Click"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
