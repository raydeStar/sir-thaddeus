<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SirThaddeus.UI.Avalonia.ViewModels"
        xmlns:local="using:SirThaddeus.UI.Avalonia"
  xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="SirThaddeus.UI.Avalonia.MainWindow"
        Width="1060"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        Title="Sir Thaddeus"
        Icon="avares://SirThaddeus.UI.Avalonia/Assets/Icons/sir-thaddeus.ico"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
        Height="52"
            Background="{DynamicResource BackgroundPrimary}">
      <Grid Margin="18,0"
        ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
            HorizontalAlignment="Left"
                    VerticalAlignment="Center"
            Spacing="8">
          <TextBlock Text="Sir Thaddeus"
                 Classes="workspaceTitle"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"/>
        <Button x:Name="ConnectionStatusButton"
            Classes="statusDotButton"
            Click="ConnectionStatusButton_Click"
            ToolTip.Tip="Disconnected"
            TabIndex="30">
        <Ellipse x:Name="ConnectionStatusDot"
             Width="8"
             Height="8"
             Fill="{DynamicResource TextTertiary}"/>
        </Button>
        <TextBlock x:Name="ConnectionStatusText"
             Classes="workspaceConnectionState"
             IsVisible="False"
             Text="Disconnected"
             Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="ConversationTitleText"
                 Classes="workspaceConversationTitle"
                     IsVisible="False"
                 Text="Conversation"
                 MaxWidth="260"
                 TextTrimming="CharacterEllipsis"/>
          <ToggleButton x:Name="ChatTabButton"
                        IsVisible="False"
                        Content="Chat"
                        IsChecked="True"
                        Click="ViewTab_Click"/>
          <ToggleButton x:Name="BriefingTabButton"
                        IsVisible="False"
                        Content="Briefing"
                        IsChecked="False"
                        Click="ViewTab_Click"/>
        </StackPanel>

                    <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                        HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="8">
          <Button x:Name="StopAllButton"
            Classes="stopAllIconButton"
            Click="StopAllButton_Click"
            ToolTip.Tip="Stop All"
            Opacity="0.4"
            TabIndex="31">
            <ic:SymbolIcon Symbol="Stop"
                           FontSize="20"
                           Foreground="White"/>
          </Button>
          <ToggleButton x:Name="SettingsTabButton"
                        Classes="iconToggleButton"
                        IsChecked="False"
                        Click="ViewTab_Click"
                        ToolTip.Tip="Settings"
                        TabIndex="32">
            <ic:SymbolIcon Symbol="Settings"
                           FontSize="20"
                           Foreground="{DynamicResource TextSecondary}"/>
          </ToggleButton>
          <Button x:Name="NewChatButton"
            Classes="iconButton"
            Click="NewChatButton_Click"
            ToolTip.Tip="New chat"
            TabIndex="33">
            <ic:SymbolIcon Symbol="NotepadEdit"
                           FontSize="20"
                           Foreground="{DynamicResource TextSecondary}"/>
          </Button>
          <Button x:Name="ConnectButton"
                  IsVisible="False"
                  Content="Connect"
                  Click="ConnectButton_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Border x:Name="ConversationDrawer"
              Grid.Column="0"
              Width="280"
              IsVisible="False"
              Background="{StaticResource CrustBrush}"
              BorderBrush="{StaticResource Surface0Brush}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid Grid.Row="0" Margin="12,12,12,8" ColumnDefinitions="*,Auto">
            <TextBlock Text="Conversations" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Classes="headerBtn" Click="CloseConversationDrawerButton_Click"/>
          </Grid>

          <StackPanel Grid.Row="1" Margin="12,0,12,8" Orientation="Horizontal" Spacing="8">
            <Button Content="New Chat" Classes="actionBtn" Click="NewChatButton_Click"/>
            <Button Content="Clear History" Classes="actionBtn" Click="ClearHistoryButton_Click"/>
          </StackPanel>

          <ListBox x:Name="ChatHistoryList"
                   Grid.Row="2"
                   Margin="8,0,8,8"
                   SelectionChanged="ChatHistoryList_SelectionChanged"
                   Background="{StaticResource BaseBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="12,10" Margin="0,0,0,4" Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{ReflectionBinding UpdatedLabel}" FontSize="10" Foreground="{StaticResource Overlay0Brush}"/>
                    <TextBlock Text="{ReflectionBinding Preview}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="3"
                     Margin="12,0,12,12"
                     Text="Select a conversation to restore that transcript."
                     FontSize="11"
                     Foreground="{StaticResource Overlay0Brush}"
                     TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <Grid Grid.Column="0">
        <Grid x:Name="ChatView">
          <Grid>

            <ScrollViewer x:Name="ChatScroller"
                          Background="{DynamicResource BackgroundPrimary}"
                    VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
              <Grid x:Name="ChatSurfaceLayout"
                HorizontalAlignment="Stretch"
                    MaxWidth="860"
                  MinHeight="200"
                    Margin="24,0,24,0">
                <StackPanel x:Name="HomeCommandStage"
                            HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="560"
                      Margin="0,-18,0,40"
                      Spacing="18">
                  <ItemsControl x:Name="RuntimeStatusStrip"
                        Margin="0,0,0,6"
                                HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="runtimeStatusPill"
                                Margin="3">
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8">
                            <ic:SymbolIcon Symbol="{ReflectionBinding IconSymbol}"
                                           FontSize="14"
                                           Foreground="{ReflectionBinding AccentBrush}"
                                           VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                              <TextBlock Text="{ReflectionBinding Label}"
                                         Classes="runtimeStatusLabel"/>
                              <TextBlock Text="{ReflectionBinding Value}"
                                         Classes="runtimeStatusValue"
                                         Foreground="{ReflectionBinding AccentBrush}"/>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel x:Name="EmptyHero"
                              HorizontalAlignment="Center"
                              Margin="0,6,0,0"
                              Spacing="0">
                    <Border Classes="homeHeroMedallion"
                            Width="50"
                            Height="50"
                            CornerRadius="25"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource BackgroundTertiary}"
                            BorderBrush="{DynamicResource BorderMuted}"
                            BorderThickness="1"
                            Margin="0,0,0,12">
                      <TextBlock Text="ST"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontFamily="Georgia, Cambria, Segoe UI Variable, Segoe UI"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource AccentPrimary}"/>
                    </Border>
                    <TextBlock Text="Ready for commands."
                               Classes="homeHeroTitle"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose a guided command or write directly below."
                               Classes="homeHeroSubtitle"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                  </StackPanel>

                  <ItemsControl x:Name="SuggestionChipsPanel"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                MaxWidth="500">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="10"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="suggestionChipButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="SuggestionChipButton_Click"
                                TabIndex="10">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="{ReflectionBinding IconSymbol}"
                                           Classes="suggestionChipIcon"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{ReflectionBinding Label}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <ItemsControl x:Name="ChatMessagesList"
                              HorizontalAlignment="Stretch"
                              Width="{Binding Bounds.Width, ElementName=ChatSurfaceLayout}"
                              Margin="0,20,0,36"
                              Background="Transparent">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageItem">
                      <Border Classes="chatMessageCard"
                              Margin="0,0,0,14"
                              HorizontalAlignment="Stretch"
                              CornerRadius="{StaticResource RadiusMd}"
                              Padding="18,16">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Copy" Click="CopyMessage_Click"/>
                            <MenuItem Header="Retry" Click="RetryMessage_Click" IsVisible="{Binding IsAssistant}"/>
                            <MenuItem Header="Read Aloud" Click="ReadAloudMessage_Click" IsVisible="{Binding IsAssistant}"/>
                          </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                          <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding AuthorLabel}"
                                         Classes="chatMessageAuthor"/>
                              <TextBlock Text="/"
                                         Classes="chatMessageMetaSeparator"
                                         VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding TimeDisplay}"
                                         Classes="chatMessageTimestamp"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="⋯"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Padding="6,0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextTertiary}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    Classes="messageMenuBtn">
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                  <MenuItem Header="Copy" Click="CopyMessage_Click"/>
                                  <MenuItem Header="Retry" Click="RetryMessage_Click" IsVisible="{Binding IsUser}"/>
                                  <MenuItem Header="Read Aloud" Click="ReadAloudMessage_Click" IsVisible="{Binding IsAssistant}"/>
                                </MenuFlyout>
                              </Button.Flyout>
                            </Button>
                          </Grid>

                          <Border IsVisible="{Binding HasThoughtContent}"
                                  Background="{DynamicResource BackgroundPrimary}"
                                  CornerRadius="{StaticResource RadiusSm}"
                                  Padding="12,8"
                                  Margin="0,0,0,8">
                            <Expander IsExpanded="{Binding IsThoughtExpanded}" Padding="0">
                              <Expander.Header>
                                <TextBlock Text="Reasoning" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiary}"/>
                              </Expander.Header>
                              <SelectableTextBlock Text="{Binding ThoughtContent}"
                                                   FontSize="12"
                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                   LineHeight="18"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Padding="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="300"/>
                            </Expander>
                          </Border>

                          <Border IsVisible="{Binding HasPlanContent}"
                                  Background="{DynamicResource BackgroundPrimary}"
                                  CornerRadius="{StaticResource RadiusSm}"
                                  Padding="12,8"
                                  Margin="0,0,0,8">
                            <Expander IsExpanded="{Binding IsPlanExpanded}" Padding="0">
                              <Expander.Header>
                                <TextBlock Text="Plan" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiary}"/>
                              </Expander.Header>
                              <SelectableTextBlock Text="{Binding PlanContent}"
                                                   FontSize="12"
                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                   LineHeight="18"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Padding="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="300"/>
                            </Expander>
                          </Border>

                          <local:MarkdownTextBlock Markdown="{Binding Content}"
                                                   FontSize="15"
                                                   LineHeight="24"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>

                          <ItemsControl IsVisible="{Binding HasSourceCards}"
                                        ItemsSource="{Binding SourceCards}"
                                        Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ChatSourceCardItem">
                                <Border Background="{DynamicResource BackgroundSecondary}"
                                        BorderBrush="{DynamicResource BorderMuted}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                  <Grid ColumnDefinitions="92,*" ColumnSpacing="12">
                                    <Border Width="92"
                                            Height="72"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            Background="{DynamicResource BackgroundPrimary}">
                                      <Grid>
                                        <TextBlock Text="{Binding DomainInitial}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Image Source="{Binding ThumbnailImage}"
                                               IsVisible="{Binding HasThumbnailImage}"
                                               Stretch="UniformToFill"/>
                                      </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="6">
                                      <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                Background="{DynamicResource BackgroundPrimary}"
                                                ClipToBounds="True">
                                          <Grid>
                                            <TextBlock Text="{Binding DomainInitial}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Image Source="{Binding FaviconImage}"
                                                   IsVisible="{Binding HasFaviconImage}"
                                                   Stretch="UniformToFill"/>
                                          </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Domain}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                      </StackPanel>

                                      <TextBlock Text="{Binding Title}"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 TextWrapping="Wrap"
                                                 MaxLines="2"/>

                                      <TextBlock Text="{Binding Excerpt}"
                                                 IsVisible="{Binding HasExcerpt}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextSecondary}"
                                                 TextWrapping="Wrap"
                                                 MaxLines="3"/>

                                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding MetaLine}"
                                                   IsVisible="{Binding HasMetaLine}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="Open source"
                                                Tag="{Binding Url}"
                                                Click="AssistantSourceCardOpenButton_Click"
                                                Classes="actionBtn"
                                                MinHeight="28"
                                                Padding="10,4"/>
                                      </Grid>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <TextBlock IsVisible="{Binding HasToolSummary}"
                                     Classes="chatMessageToolSummary"
                                     Text="{Binding ToolSummary}"
                                     Margin="0,8,0,0"
                                     Opacity="0.7"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>

        <Grid x:Name="BriefingView" IsVisible="False" Background="{StaticResource BaseBrush}">
          <Grid ColumnDefinitions="260,*,320">
            <Border Grid.Column="0"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,1,0">
              <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="16,16,16,12" Spacing="4">
                  <TextBlock Text="Briefing History" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock x:Name="BriefingHistoryHintText"
                             Text="Deep-dive results from this conversation appear here."
                             FontSize="11"
                             Foreground="{StaticResource Overlay0Brush}"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox Grid.Row="1"
                         x:Name="BriefingHistoryList"
                         Margin="10,0,10,10"
                         SelectionChanged="BriefingHistoryList_SelectionChanged"
                         Background="{StaticResource BaseBrush}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,6" Padding="10,8" Background="{StaticResource Surface0Brush}" CornerRadius="6">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Background="{ReflectionBinding ConfidenceBrush}" CornerRadius="999" Padding="8,2">
                              <TextBlock Text="{ReflectionBinding ConfidenceLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BaseBrush}"/>
                            </Border>
                          </Grid>
                          <TextBlock Text="{ReflectionBinding StatusLine}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap" MaxLines="2"/>
                          <TextBlock Text="{ReflectionBinding UpdatedLabel}" FontSize="10" Foreground="{StaticResource Overlay0Brush}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="24,20,20,20" MaxWidth="760" Spacing="14">
                <Border Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="12,10">
                  <TextBlock x:Name="BriefingStatusText"
                             Text="No briefing loaded yet. Ask for a place or product deep dive in chat."
                             FontSize="12"
                             Foreground="{StaticResource Subtext0Brush}"
                             TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="BriefingEmptyState"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="24,22">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="No briefing loaded"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Use chat to ask about a business, place, or product. Structured briefing output will appear here when the runtime returns it."
                               MaxWidth="480"
                               FontSize="12"
                               Foreground="{StaticResource Overlay0Brush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                  </StackPanel>
                </Border>

                <Border x:Name="BriefingHeroCard"
                        IsVisible="False"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="16,14">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock x:Name="BriefingHeroTitleText" Text="Briefing title" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BriefingHeroStatusText" Text="Status line" FontSize="14" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Border x:Name="BriefingConfidenceBadge" Background="{StaticResource Surface0Brush}" CornerRadius="999" Padding="10,4" VerticalAlignment="Top">
                        <TextBlock x:Name="BriefingConfidenceText" Text="Unknown" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource CrustBrush}"/>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <Border Background="{StaticResource BaseBrush}" CornerRadius="8" Padding="10,8" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Checked" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                          <TextBlock x:Name="BriefingLastCheckedText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Background="{StaticResource BaseBrush}" CornerRadius="8" Padding="10,8" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Hours" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                          <TextBlock x:Name="BriefingClosesText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Name="BriefingWebsiteButton" Content="Website" Classes="actionBtn" IsEnabled="False" Click="BriefingWebsiteButton_Click"/>
                      <Button x:Name="BriefingDirectionsButton" Content="Directions" Classes="actionBtn" IsEnabled="False" Click="BriefingDirectionsButton_Click"/>
                      <Button x:Name="BriefingCopyPhoneButton" Content="Copy Phone" Classes="actionBtn" IsEnabled="False" Click="BriefingCopyPhoneButton_Click"/>
                      <Button x:Name="BriefingCopyAddressButton" Content="Copy Address" Classes="actionBtn" IsEnabled="False" Click="BriefingCopyAddressButton_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <ItemsControl x:Name="BriefingCardsList" IsVisible="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,12"
                              Padding="14,12"
                              Background="{StaticResource MantleBrush}"
                              BorderBrush="{StaticResource Surface0Brush}"
                              BorderThickness="1"
                              CornerRadius="{StaticResource RadiusMd}">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{ReflectionBinding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding TypeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                          </Grid>
                          <ItemsControl ItemsSource="{ReflectionBinding Bullets}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                  <TextBlock Text="- " FontSize="12" Foreground="{StaticResource Overlay0Brush}"/>
                                  <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Subtext1Brush}" TextWrapping="Wrap" MaxWidth="620"/>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{ReflectionBinding SourceSummary}" FontSize="11" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="BriefingAuditSection"
                        IsVisible="False"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}">
                  <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Audit Trail" Margin="14,12,14,4" FontSize="13" FontWeight="SemiBold"/>
                    <ListBox x:Name="BriefingAuditList" Grid.Row="1" Margin="10,0,10,10" Background="Transparent">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,6" Padding="10,8" Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{ReflectionBinding StepLabel}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{ReflectionBinding TimestampLabel}" FontSize="10" Foreground="{StaticResource Overlay0Brush}"/>
                              </Grid>
                              <TextBlock Text="{ReflectionBinding Detail}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap"/>
                              <TextBlock Text="{ReflectionBinding SourceSummary}" FontSize="10" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="1,0,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,18,16,18" Spacing="14">
                  <TextBlock Text="Quick Info" FontSize="13" FontWeight="SemiBold"/>

                  <Border Background="{StaticResource BaseBrush}"
                          CornerRadius="{StaticResource RadiusMd}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1"
                          Padding="12,10">
                    <StackPanel Spacing="8">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Address" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                        <TextBlock x:Name="BriefingAddressText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Phone" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                        <TextBlock x:Name="BriefingPhoneText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Query" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Overlay0Brush}"/>
                        <TextBlock x:Name="BriefingQueryText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border x:Name="BriefingMapSection"
                          IsVisible="False"
                          Background="{StaticResource BaseBrush}"
                          CornerRadius="{StaticResource RadiusMd}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1"
                          Padding="12,10">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Map" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock x:Name="BriefingMapLabelText" Text="Map" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock x:Name="BriefingMapCoordsText" Text="-" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap"/>
                      <TextBlock Text="Coordinates are shown now; platform map embedding can land later without changing the contract."
                                 FontSize="10"
                                 Foreground="{StaticResource Overlay0Brush}"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>

                  <Border x:Name="BriefingSourcesSection"
                          IsVisible="False"
                          Background="{StaticResource BaseBrush}"
                          CornerRadius="{StaticResource RadiusMd}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                      <TextBlock Grid.Row="0" Text="Sources" Margin="12,10,12,4" FontSize="13" FontWeight="SemiBold"/>
                      <ListBox x:Name="BriefingSourcesList" Grid.Row="1" Margin="8,0,8,8" Background="Transparent">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="10,8" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="{ReflectionBinding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                  <TextBlock Text="{ReflectionBinding Meta}" FontSize="10" Foreground="{StaticResource Overlay0Brush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Open"
                                        Classes="actionBtn"
                                        Tag="{ReflectionBinding Url}"
                                        Click="BriefingSourceOpenButton_Click"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="SettingsView" IsVisible="False" Background="{DynamicResource SettingsContentBg}">
          <Grid RowDefinitions="Auto,*" RowSpacing="0">
            <Border x:Name="SettingsHeaderBar"
                    Classes="settingsShellHeader"
                    x:CompileBindings="False"
                    Margin="24,14,24,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="6" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Settings" Classes="settingsShellTitle"/>
                  <Border Classes="settingsStatusPill" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiary}"/>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <Button x:Name="ReloadSettingsButton"
                          Content="Reload"
                          Classes="settingsSecondaryButton"
                          Click="ReloadSettingsButton_Click"/>
                  <Button x:Name="SaveSettingsButton"
                          Content="Save"
                          Classes="settingsPrimaryButton"
                          IsEnabled="{Binding IsDirty}"
                          Click="SaveSettingsButton_Click"/>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1"
                  ColumnDefinitions="200,*"
                  ColumnSpacing="18"
                  Margin="16,12,20,20">
            <TabControl Grid.Column="0"
                        x:Name="SettingsTabControl"
                        Classes="settingsTabs"
                        TabStripPlacement="Left"
                        Padding="0"
                        Background="Transparent"
                        SelectedIndex="1"
                        SelectionChanged="SettingsTabControl_SelectionChanged"> 
            
            <TabItem Header="SYSTEM" Classes="navGroupHeader" IsEnabled="False"/>

            <TabItem x:Name="GeneralTabItem" Header="General" x:CompileBindings="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,36,32" MaxWidth="760" Spacing="22">

                  <StackPanel Spacing="12">
                    <TextBlock Text="SYSTEM STATUS" Classes="sectionLabel"/>
                    <Border Classes="settingsStatusCard">
                      <StackPanel Spacing="18">
                        <WrapPanel ItemWidth="220" Orientation="Horizontal">
                          <Border Classes="settingsMetricTile" Width="220" Margin="0,0,14,14">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Current runtime" Classes="settingsMetricLabel"/>
                              <TextBlock x:Name="SettingsRuntimeText"
                                         Text="Runtime: not connected"
                                         Classes="settingsMetricValue"/>
                            </StackPanel>
                          </Border>
                          <Border Classes="settingsMetricTile" Width="220" Margin="0,0,14,14">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Managed service" Classes="settingsMetricLabel"/>
                              <TextBlock x:Name="RuntimeLaunchStateText"
                                         Text="Managed runtime: not running"
                                         Classes="settingsMetricValue"/>
                            </StackPanel>
                          </Border>
                          <Border Classes="settingsMetricTile" Width="220" Margin="0,0,0,14">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Settings state" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding StatusText}" Classes="settingsMetricValue"/>
                            </StackPanel>
                          </Border>
                        </WrapPanel>
                        <TextBlock Text="Live status before you change anything."
                                   Classes="hint"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="12">
                    <TextBlock Text="RUNTIME CONNECTION" Classes="sectionLabel"/>
                    <WrapPanel ItemWidth="320" Orientation="Horizontal">
                      <Border Classes="settingsCard" Margin="0,0,16,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Connection target" Classes="settingsCardTitle"/>
                            <TextBlock Text="Endpoint for the runtime connection."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <TextBox x:Name="RuntimeUrlBox"
                                   Text="http://127.0.0.1:5378"
                                   Classes="chatInput"
                                   FontSize="13"
                                   Padding="12,10"/>
                          <Button Content="Connect to runtime"
                                  Classes="settingsSecondaryButton"
                                  HorizontalAlignment="Left"
                                  Click="ConnectButton_Click"/>
                          <TextBlock Text="Loopback for local, or a remote address for cross-machine."
                                     Classes="hint"/>
                        </StackPanel>
                      </Border>

                      <Border Classes="settingsCard" Margin="0,0,0,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Runtime controls" Classes="settingsCardTitle"/>
                            <TextBlock Text="Start or stop the managed runtime."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartRuntimeButton"
                                    Content="Start local runtime"
                                    Classes="actionBtn"
                                    Click="StartRuntimeButton_Click"/>
                            <Button x:Name="StopRuntimeButton"
                                    Content="Stop managed runtime"
                                    Classes="actionBtn"
                                    Click="StopRuntimeButton_Click"/>
                          </StackPanel>
                          <Border Classes="settingsMetricTile">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Control state" Classes="settingsMetricLabel"/>
                              <TextBlock Text="Manages the local runtime process."
                                         Classes="settingsMetricMeta"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel Spacing="12">
                    <TextBlock Text="INTERACTION PREFERENCES" Classes="sectionLabel"/>
                    <WrapPanel ItemWidth="320" Orientation="Horizontal">
                      <Border Classes="settingsCard" Margin="0,0,16,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Desktop behavior" Classes="settingsCardTitle"/>
                            <TextBlock Text="Defaults for sending, auto-connect, and system tray."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <StackPanel Spacing="10">
                            <CheckBox x:Name="SendOnEnterCheckBox" Content="Send on Enter (Shift+Enter for newline)" Classes="settingsCheck" Click="SendOnEnterCheckBox_Click"/>
                            <CheckBox x:Name="AutoSwitchPermissionsCheckBox" Content="Auto-switch to Permissions on approval request" Classes="settingsCheck" Click="AutoSwitchPermissionsCheckBox_Click"/>
                            <CheckBox x:Name="AutoConnectCheckBox" Content="Auto-connect on startup" Classes="settingsCheck" Click="AutoConnectCheckBox_Click"/>
                            <CheckBox x:Name="AutoStartRuntimeCheckBox" Content="Auto-start local runtime if unavailable" Classes="settingsCheck" Click="AutoStartRuntimeCheckBox_Click"/>
                            <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to tray on close" Classes="settingsCheck" Click="MinimizeToTrayCheckBox_Click"/>
                          </StackPanel>
                          <TextBlock x:Name="TraySupportText"
                                     Text="Tray support is being detected..."
                                     Classes="hint"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                      </Border>

                      <Border Classes="settingsCard" Margin="0,0,0,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Shortcuts and voice" Classes="settingsCardTitle"/>
                            <TextBlock Text="Keyboard navigation and voice chord bindings."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <Border Classes="settingsMetricTile">
                            <TextBlock Text="Ctrl+1 Chat  •  Ctrl+2 Briefing  •  Ctrl+3 Settings"
                                       Classes="settingsMetricMeta"/>
                          </Border>
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Push-to-talk chord" Classes="hint"/>
                              <TextBox Text="{ReflectionBinding PttChord}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Text="Interrupt chord" Classes="hint"/>
                              <TextBox Text="{ReflectionBinding ShutupChord}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="Voice and read-aloud are currently Windows-only."
                                     Classes="hint"/>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel Spacing="12">
                    <TextBlock Text="ADVANCED" Classes="sectionLabel"/>
                    <Border x:Name="ConstraintsPanel" Classes="settingsCard" x:CompileBindings="False">
                      <Expander IsExpanded="False">
                        <Expander.Header>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Limits and tool budgets" Classes="settingsCardTitle"/>
                            <TextBlock Text="Guardrails for tool-heavy sessions."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                        </Expander.Header>
                        <Grid Margin="0,18,0,0"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="14"
                              ColumnSpacing="16">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="Max tool calls per turn" Classes="formLabel"/>
                          <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding MaxToolCallsPerTurn}" Minimum="1" Maximum="100" HorizontalAlignment="Right" Width="120" FontSize="13" Padding="10,8"/>

                          <TextBlock Grid.Row="1" Grid.Column="0" Text="Max tool calls per session" Classes="formLabel"/>
                          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxToolCallsPerSession}" Minimum="1" Maximum="10000" HorizontalAlignment="Right" Width="120" FontSize="13" Padding="10,8"/>

                          <TextBlock Grid.Row="2" Grid.Column="0" Text="Max web pulls per turn" Classes="formLabel"/>
                          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaxWebPullsPerTurn}" Minimum="0" Maximum="25" HorizontalAlignment="Right" Width="120" FontSize="13" Padding="10,8"/>

                          <TextBlock Grid.Row="3" Grid.Column="0" Text="Max file ops per minute" Classes="formLabel"/>
                          <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MaxFileOpsPerMinute}" Minimum="0" Maximum="600" HorizontalAlignment="Right" Width="120" FontSize="13" Padding="10,8"/>
                        </Grid>
                      </Expander>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Location" x:CompileBindings="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,36,32" MaxWidth="680" Spacing="20">
                  <StackPanel Spacing="10">
                    <TextBlock Text="LOCATION" Classes="sectionLabel"/>
                    <Border Classes="settingsCard">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Manual location for nearby searches (city/state, ZIP, or country)." Classes="hint"/>
                        <TextBox Text="{ReflectionBinding Location}"
                                 Watermark="e.g., Olympia, WA"
                                 Classes="chatInput"
                                 FontSize="13"
                                 Padding="12,10"/>
                        <Border Classes="separator" Margin="0,4,0,2"/>
                        <TextBlock Text="Display" Classes="hint"/>
                        <CheckBox Content="Use 24-hour time (military time)" IsChecked="{ReflectionBinding Use24HourTime}" Classes="settingsCheck"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                          <TextBlock Text="Preferred units" Classes="formLabel" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1"
                                    ItemsSource="{ReflectionBinding PreferredUnitsOptions}"
                                    SelectedItem="{ReflectionBinding PreferredUnits}"
                                    HorizontalAlignment="Left"
                                    MinWidth="140"
                                    FontSize="13"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem x:Name="LlmsTabItem" Header="Models" x:CompileBindings="False">
              <ScrollViewer x:Name="LlmsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,36,32" MaxWidth="760" Spacing="22">

                  <StackPanel Spacing="12">
                    <TextBlock Text="PRIMARY MODEL" Classes="sectionLabel"/>
                    <WrapPanel ItemWidth="320" Orientation="Horizontal">
                      <Border Classes="settingsCard" Margin="0,0,16,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Connection presets" Classes="settingsCardTitle"/>
                            <TextBlock Text="Quick-select a common endpoint, then fine-tune."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <WrapPanel Orientation="Horizontal" ItemHeight="32">
                            <Button x:Name="LmStudioPresetBtn" Content="LM Studio" Classes="actionBtn" Tag="http://localhost:1234" Margin="0,0,8,8"/>
                            <Button x:Name="OllamaPresetBtn" Content="Ollama" Classes="actionBtn" Tag="http://localhost:11434" Margin="0,0,8,8"/>
                            <Button x:Name="OpenAiPresetBtn" Content="OpenAI" Classes="actionBtn" Tag="https://api.openai.com" Margin="0,0,0,8"/>
                          </WrapPanel>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Base URL" Classes="hint"/>
                            <TextBox Text="{Binding LlmBaseUrl}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Model ID" Classes="hint"/>
                            <TextBox Text="{Binding LlmModel}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <Border Classes="settingsCard" Margin="0,0,0,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Model discovery" Classes="settingsCardTitle"/>
                            <TextBlock Text="Query the endpoint for available models."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <Button Content="Refresh models"
                                  Classes="settingsSecondaryButton"
                                  HorizontalAlignment="Left"
                                  Click="RefreshPrimaryModelsButton_Click"/>
                          <TextBlock Text="Queries /v1/models on the base URL."
                                     Classes="hint"/>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Discovered models" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding AvailablePrimaryModels}" SelectedItem="{Binding LlmModel}" HorizontalAlignment="Stretch"/>
                          </StackPanel>
                          <Border Classes="settingsMetricTile">
                            <TextBlock Text="Type the ID directly, or pick from the discovered list."
                                       Classes="settingsMetricMeta"/>
                          </Border>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel Spacing="12">
                    <TextBlock Text="VERIFICATION MODEL" Classes="sectionLabel"/>
                    <WrapPanel ItemWidth="320" Orientation="Horizontal">
                      <Border Classes="settingsCard" Margin="0,0,16,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Gatekeeper endpoint" Classes="settingsCardTitle"/>
                            <TextBlock Text="Route verification through a separate, smaller model."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Base URL" Classes="hint"/>
                            <TextBox Text="{Binding GatekeeperBaseUrl}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Model ID" Classes="hint"/>
                            <TextBox Text="{Binding GatekeeperModelId}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                          <Border Classes="settingsMetricTile">
                            <StackPanel Spacing="6">
                              <TextBlock Text="Effective fallback" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding EffectiveGatekeeperBaseUrl}" Classes="settingsMetricValue"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>

                      <Border Classes="settingsCard" Margin="0,0,0,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Gatekeeper discovery" Classes="settingsCardTitle"/>
                            <TextBlock Text="Falls back to the primary endpoint when left blank."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <Button Content="Refresh gatekeeper"
                                  Classes="settingsSecondaryButton"
                                  HorizontalAlignment="Left"
                                  Click="RefreshGatekeeperModelsButton_Click"/>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Discovered models" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding AvailableGatekeeperModels}" SelectedItem="{Binding GatekeeperModelId}" HorizontalAlignment="Stretch"/>
                          </StackPanel>
                          <TextBlock Text="Saves primary-model capacity for conversation."
                                     Classes="hint"/>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel Spacing="12">
                    <TextBlock Text="RESPONSE SHAPING" Classes="sectionLabel"/>
                    <Border Classes="settingsCard">
                      <WrapPanel ItemWidth="320" Orientation="Horizontal">
                        <StackPanel Width="320" Margin="0,0,24,16" Spacing="6">
                          <TextBlock Text="Max tokens" Classes="settingsCardTitle"/>
                          <TextBlock Text="Completion ceiling. Raise when long output is clipped." Classes="settingsCardDescription"/>
                          <NumericUpDown Value="{Binding LlmMaxTokens}" Minimum="1" Maximum="32000" FontSize="13" Padding="10,8" HorizontalAlignment="Left" Width="120"/>
                        </StackPanel>
                        <StackPanel Width="320" Margin="0,0,0,16" Spacing="6">
                          <TextBlock Text="Temperature" Classes="settingsCardTitle"/>
                          <TextBlock Text="Lower values bias toward steadier outputs. Raise it only when you want more variety in phrasing or ideation." Classes="settingsCardDescription"/>
                          <NumericUpDown Value="{Binding LlmTemperature}" Minimum="0.0" Maximum="2.0" Increment="0.1" FormatString="F2" FontSize="13" Padding="10,8" HorizontalAlignment="Left" Width="120"/>
                        </StackPanel>
                      </WrapPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AudioTabItem" Header="Audio &amp; Voice" x:CompileBindings="False">
              <ScrollViewer x:Name="AudioScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,36,32" MaxWidth="680" Spacing="20">

                  <!-- Audio Devices -->
                  <StackPanel Spacing="10">
                    <TextBlock Text="AUDIO DEVICES" Classes="sectionLabel"/>
                    <Border Classes="settingsCard">
                      <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Input device" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding AvailableInputDevices}" SelectedItem="{Binding SelectedInputDevice}" HorizontalAlignment="Stretch"/>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="Output device" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding AvailableOutputDevices}" SelectedItem="{Binding SelectedOutputDevice}" HorizontalAlignment="Stretch"/>
                          </StackPanel>
                          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Input gain" Classes="hint"/>
                              <NumericUpDown Value="{Binding InputGain}" Minimum="0.0" Maximum="2.0" Increment="0.1" FormatString="F1" Width="120" FontSize="13" Padding="10,8" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding InputGain, StringFormat={}{0:F1}x}" FontSize="13" Foreground="{StaticResource Overlay0Brush}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                          </Grid>
                        </Grid>
                        <Button Content="Refresh Devices" Classes="actionBtn" Click="RefreshAudioDevicesButton_Click"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- Voice Pipeline -->
                  <StackPanel Spacing="10">
                    <TextBlock Text="VOICE PIPELINE" Classes="sectionLabel"/>
                    <Border Classes="settingsCard">
                      <StackPanel Spacing="12">
                        <CheckBox Content="Enable Local VoiceHost"
                                  IsChecked="{Binding VoiceHostEnabled}"
                                  IsEnabled="{Binding IsVoiceHostSupportedByProfile}"
                                  Classes="settingsCheck"/>
                        <TextBlock Text="{Binding VoiceHostProfileRestrictionText}"
                                   Classes="hint"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsVoiceHostRestrictedByProfile}"/>
                        <StackPanel Spacing="10" IsVisible="{Binding VoiceHostEnabled}">
                          <StackPanel Spacing="4">
                            <TextBlock Text="VoiceHost URL" Classes="hint"/>
                            <TextBox Text="{Binding VoiceHostBaseUrl}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                          <Button Content="Refresh Health" Classes="actionBtn" Click="RefreshVoiceHostHealthButton_Click"/>
                          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="16">
                            <StackPanel Spacing="2">
                              <TextBlock Text="Status" Classes="hint"/>
                              <TextBlock Text="{Binding VoiceHostStatusText}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                              <TextBlock Text="Version" Classes="hint"/>
                              <TextBlock Text="{Binding VoiceHostVersion}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="2">
                              <TextBlock Text="ASR" Classes="hint"/>
                              <TextBlock Text="{Binding VoiceHostAsrReady}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                              <TextBlock Text="TTS" Classes="hint"/>
                              <TextBlock Text="{Binding VoiceHostTtsReady}" FontSize="13"/>
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="{Binding VoiceHostMessage}" Classes="hint"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- TTS -->
                  <StackPanel Spacing="10">
                    <TextBlock Text="TEXT-TO-SPEECH" Classes="sectionLabel"/>
                    <Border Classes="settingsCard">
                      <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="TTS engine" Classes="hint"/>
                          <ComboBox ItemsSource="{Binding TtsEngineOptions}" SelectedItem="{Binding VoiceTtsEngine}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBlock Text="{Binding VoiceSectionLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"/>
                        <TextBlock Text="{Binding VoiceSectionDescription}" Classes="hint"/>
                        <StackPanel Spacing="8" IsVisible="{Binding IsWindowsEngine}">
                          <TextBlock Text="Uses the system speech synthesizer. Voice and model ID are optional." Classes="hint"/>
                        </StackPanel>
                        <StackPanel Spacing="10" IsVisible="{Binding IsPiperEngine}">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Piper voice" Classes="hint"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <ComboBox ItemsSource="{Binding AvailablePiperVoices}" SelectedItem="{Binding SelectedPiperVoice}" HorizontalAlignment="Stretch"/>
                              <Button Grid.Column="1" Content="Refresh" Classes="actionBtn" Click="RefreshTtsVoicesButton_Click"/>
                            </Grid>
                          </StackPanel>
                          <TextBlock Text="{Binding PiperVoiceDownloadStatus}" Classes="hint" Foreground="{StaticResource SapphireBrush}" IsVisible="{Binding IsPiperStatusVisible}"/>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Model ID (optional)" Classes="hint"/>
                            <TextBox Text="{Binding VoiceTtsModelId}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="10" IsVisible="{Binding IsKokoroEngine}">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Kokoro voice" Classes="hint"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <ComboBox ItemsSource="{Binding AvailableKokoroVoices}" SelectedItem="{Binding SelectedKokoroVoice}" HorizontalAlignment="Stretch"/>
                              <Button Grid.Column="1" Content="Refresh" Classes="actionBtn" Click="RefreshTtsVoicesButton_Click"/>
                            </Grid>
                          </StackPanel>
                          <TextBlock Text="Leaving blank falls back to the active personality preference." Classes="hint"/>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Model ID (optional)" Classes="hint"/>
                            <TextBox Text="{Binding VoiceTtsModelId}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- YouTube -->
                  <StackPanel Spacing="10">
                    <TextBlock Text="YOUTUBE" Classes="sectionLabel"/>
                    <Border Classes="settingsCard">
                      <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="ASR provider" Classes="hint"/>
                          <ComboBox ItemsSource="{Binding YouTubeAsrProviderOptions}" SelectedItem="{Binding YouTubeAsrProvider}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="4">
                          <TextBlock Text="Model ID / size" Classes="hint"/>
                          <TextBox Text="{Binding YouTubeAsrModelId}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="4">
                          <TextBlock Text="Language hint" Classes="hint"/>
                          <TextBox Text="{Binding YouTubeLanguageHint}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Spacing="4">
                          <TextBlock Text="Drafting tone" Classes="hint"/>
                          <ComboBox ItemsSource="{Binding YouTubeDraftToneOptions}" SelectedItem="{Binding YouTubeDraftTone}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <CheckBox Grid.Row="4" Content="Keep audio files" IsChecked="{Binding YouTubeKeepAudio}" Classes="settingsCheck"/>
                      </Grid>
                    </Border>
                  </StackPanel>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="WORKSPACE" Classes="navGroupHeader" IsEnabled="False"/>

            <TabItem x:Name="MyFilesTabItem" Header="My Files" x:CompileBindings="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,36,32" MaxWidth="680" Spacing="20">

                  <!-- File Access -->
                  <StackPanel Spacing="10">
                    <TextBlock Text="FILE ACCESS" Classes="sectionLabel"/>
                    <Border Classes="settingsCard">
                      <StackPanel Spacing="12">
                        <CheckBox Content="Do not allow any access to my files"
                                  x:Name="DisableAllFileAccessCheckBox"
                                  IsChecked="{Binding DisableAllFileAccess}"
                                  Click="DisableAllFileAccessCheckBox_Click"
                                  Classes="settingsCheck"/>
                        <TextBlock Text="Choose which folders MCP file and document tools are allowed to read. Leave this empty to use Sir Thaddeus' temporary workspace instead."
                                   Classes="hint"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button x:Name="AddAllowedFileRootButton"
                                  Content="Add Folder"
                                  Classes="actionBtn"
                                  Click="AddAllowedFileRootButton_Click"/>
                          <Button x:Name="RemoveAllowedFileRootButton"
                                  Content="Remove Selected"
                                  Classes="actionBtn"
                                  Click="RemoveAllowedFileRootButton_Click"/>
                        </StackPanel>
                        <Border BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="8">
                          <ListBox x:Name="AllowedFileRootsList"
                                   ItemsSource="{Binding AllowedFileRoots}"
                                   MinHeight="96"
                                   Background="Transparent">
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding .}" FontSize="12" TextWrapping="Wrap"/>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Border>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SearchTabItem" Header="Search" x:CompileBindings="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,36,32" MaxWidth="760" Spacing="22">

                  <StackPanel Spacing="12">
                    <TextBlock Text="SEARCH DEFAULTS" Classes="sectionLabel"/>
                    <WrapPanel ItemWidth="320" Orientation="Horizontal">
                      <Border Classes="settingsCard" Margin="0,0,16,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Live search behavior" Classes="settingsCardTitle"/>
                            <TextBlock Text="Enable or tune web searches during normal turns."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <CheckBox Content="Enable live web search" IsChecked="{Binding WebSearchEnabled}" Classes="settingsCheck"/>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Mode" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding WebSearchModeOptions}" SelectedItem="{Binding WebSearchMode}" HorizontalAlignment="Stretch"/>
                          </StackPanel>
                          <WrapPanel ItemWidth="150" Orientation="Horizontal">
                            <StackPanel Width="150" Margin="0,0,16,8" Spacing="4">
                              <TextBlock Text="Timeout (ms)" Classes="hint"/>
                              <NumericUpDown Value="{Binding WebSearchTimeoutMs}" Minimum="1000" Maximum="120000" Increment="500" Width="120" FontSize="13" Padding="10,8" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,0,8" Spacing="4">
                              <TextBlock Text="Max results" Classes="hint"/>
                              <NumericUpDown Value="{Binding WebSearchMaxResults}" Minimum="1" Maximum="20" Width="120" FontSize="13" Padding="10,8" HorizontalAlignment="Left"/>
                            </StackPanel>
                          </WrapPanel>
                        </StackPanel>
                      </Border>

                      <Border Classes="settingsCard" Margin="0,0,0,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Policy handoff" Classes="settingsCardTitle"/>
                            <TextBlock Text="Web permission policy applies alongside search settings."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <StackPanel Spacing="4">
                            <TextBlock Text="MCP web permission" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding PermissionOptions}" SelectedItem="{Binding McpWeb}" HorizontalAlignment="Stretch"/>
                          </StackPanel>
                          <Border Classes="settingsMetricTile">
                            <StackPanel Spacing="6">
                              <TextBlock Text="Effective policy" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding SearchWebPermissionEffective}" Classes="settingsMetricValue"/>
                              <TextBlock Text="Broader approval defaults live in Permissions."
                                         Classes="settingsMetricMeta"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel Spacing="12">
                    <TextBlock Text="PROVIDERS" Classes="sectionLabel"/>
                    <WrapPanel ItemWidth="320" Orientation="Horizontal">
                      <Border Classes="settingsCard" Margin="0,0,16,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Bundled SearXNG" Classes="settingsCardTitle"/>
                            <TextBlock Text="Local metasearch instance managed by Sir Thaddeus."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <CheckBox Content="Auto-start bundled local SearXNG"
                                    IsChecked="{Binding SearxngAutoStart}"
                                    IsEnabled="{Binding IsSearxngAutoStartSupportedByProfile}"
                                    Classes="settingsCheck"/>
                          <TextBlock Text="{Binding SearxngProfileRestrictionText}"
                                     Classes="hint"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding IsSearxngAutoStartRestrictedByProfile}"/>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Base URL" Classes="hint"/>
                            <TextBox Text="{Binding SearxngBaseUrl}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                          <WrapPanel ItemWidth="150" Orientation="Horizontal">
                            <Border Classes="settingsMetricTile" Width="150" Margin="0,0,12,12">
                              <StackPanel Spacing="4">
                                <TextBlock Text="Status" Classes="settingsMetricLabel"/>
                                <TextBlock Text="{Binding SearchSearxngStatusText}" Classes="settingsMetricValue"/>
                              </StackPanel>
                            </Border>
                            <Border Classes="settingsMetricTile" Width="150" Margin="0,0,0,12">
                              <StackPanel Spacing="4">
                                <TextBlock Text="Reachable" Classes="settingsMetricLabel"/>
                                <TextBlock Text="{Binding SearchSearxngReachableText}" Classes="settingsMetricValue"/>
                              </StackPanel>
                            </Border>
                            <Border Classes="settingsMetricTile" Width="150" Margin="0,0,12,0">
                              <StackPanel Spacing="4">
                                <TextBlock Text="Managed" Classes="settingsMetricLabel"/>
                                <TextBlock Text="{Binding SearchSearxngManagedText}" Classes="settingsMetricValue"/>
                              </StackPanel>
                            </Border>
                            <Border Classes="settingsMetricTile" Width="150">
                              <StackPanel Spacing="4">
                                <TextBlock Text="Last launch" Classes="settingsMetricLabel"/>
                                <TextBlock Text="{Binding SearchSearxngLastLaunchStatus}" Classes="settingsMetricValue"/>
                              </StackPanel>
                            </Border>
                          </WrapPanel>
                          <TextBlock Text="{Binding SearchSearxngMessage}" Classes="hint"/>
                        </StackPanel>
                      </Border>

                      <Border Classes="settingsCard" Margin="0,0,0,16">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Hosted search API" Classes="settingsCardTitle"/>
                            <TextBlock Text="Remote search provider with managed credentials."
                                       Classes="settingsCardDescription"/>
                          </StackPanel>
                          <StackPanel Spacing="4">
                            <TextBlock Text="API key" Classes="hint"/>
                            <TextBox Text="{Binding SearchApiKey}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Base URL" Classes="hint"/>
                            <TextBox Text="{Binding SearchApiBaseUrl}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Engine" Classes="hint"/>
                            <TextBox Text="{Binding SearchApiEngine}" Classes="chatInput" FontSize="13" Padding="12,10"/>
                          </StackPanel>
                          <Border Classes="settingsMetricTile">
                            <StackPanel Spacing="6">
                              <TextBlock Text="Hosted provider status" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding SearchSearchApiStatusText}" Classes="settingsMetricValue"/>
                              <TextBlock Text="{Binding SearchSearchApiMessage}" Classes="settingsMetricMeta"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel Spacing="12">
                    <TextBlock Text="RUNTIME VISIBILITY" Classes="sectionLabel"/>
                    <Border Classes="settingsCard">
                      <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Button x:Name="RefreshSearchStatusButton"
                                  Content="Refresh search status"
                                  Classes="settingsSecondaryButton"
                                  Click="RefreshSearchStatusButton_Click"/>
                          <TextBlock Text="Refreshes search availability and MCP state."
                                     Classes="hint"
                                     VerticalAlignment="Center"/>
                        </StackPanel>

                        <WrapPanel ItemWidth="150" Orientation="Horizontal">
                          <Border Classes="settingsMetricTile" Width="150" Margin="0,0,12,12">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Effective status" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding SearchStatusText}" Classes="settingsMetricValue"/>
                            </StackPanel>
                          </Border>
                          <Border Classes="settingsMetricTile" Width="150" Margin="0,0,12,12">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Live search" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding SearchLiveSearchAvailableText}" Classes="settingsMetricValue"/>
                            </StackPanel>
                          </Border>
                          <Border Classes="settingsMetricTile" Width="150" Margin="0,0,12,12">
                            <StackPanel Spacing="4">
                              <TextBlock Text="MCP status" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding SearchMcpStatusText}" Classes="settingsMetricValue"/>
                            </StackPanel>
                          </Border>
                          <Border Classes="settingsMetricTile" Width="150" Margin="0,0,12,12">
                            <StackPanel Spacing="4">
                              <TextBlock Text="MCP tools" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding SearchMcpToolsAvailableText}" Classes="settingsMetricValue"/>
                            </StackPanel>
                          </Border>
                          <Border Classes="settingsMetricTile" Width="150" Margin="0,0,12,12">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Last checked" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding SearchLastCheckedText}" Classes="settingsMetricValue"/>
                            </StackPanel>
                          </Border>
                        </WrapPanel>

                        <Border Classes="settingsMetricTile">
                          <StackPanel Spacing="6">
                            <TextBlock Text="MCP server path" Classes="settingsMetricLabel"/>
                            <TextBlock Text="{Binding SearchMcpServerPath}" Classes="settingsMetricMeta"/>
                          </StackPanel>
                        </Border>

                        <StackPanel Spacing="10">
                          <TextBlock Text="LAST TRACE" Classes="sectionLabel" Margin="0,4,0,0"/>
                          <WrapPanel ItemWidth="220" Orientation="Horizontal">
                            <Border Classes="settingsMetricTile" Width="220" Margin="0,0,12,12">
                              <StackPanel Spacing="4">
                                <TextBlock Text="Status" Classes="settingsMetricLabel"/>
                                <TextBlock Text="{Binding SearchLastProviderStatusText}" Classes="settingsMetricValue"/>
                              </StackPanel>
                            </Border>
                            <Border Classes="settingsMetricTile" Width="220" Margin="0,0,12,12">
                              <StackPanel Spacing="4">
                                <TextBlock Text="Provider" Classes="settingsMetricLabel"/>
                                <TextBlock Text="{Binding SearchLastProviderText}" Classes="settingsMetricValue"/>
                              </StackPanel>
                            </Border>
                            <Border Classes="settingsMetricTile" Width="220" Margin="0,0,0,12">
                              <StackPanel Spacing="4">
                                <TextBlock Text="Time" Classes="settingsMetricLabel"/>
                                <TextBlock Text="{Binding SearchLastProviderCheckedText}" Classes="settingsMetricValue"/>
                              </StackPanel>
                            </Border>
                          </WrapPanel>
                          <Border Classes="settingsMetricTile">
                            <StackPanel Spacing="6">
                              <TextBlock Text="Query" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding SearchLastQueryText}" Classes="settingsMetricMeta"/>
                            </StackPanel>
                          </Border>
                          <Border Classes="settingsMetricTile">
                            <StackPanel Spacing="6">
                              <TextBlock Text="Trace path" Classes="settingsMetricLabel"/>
                              <TextBlock Text="{Binding SearchLastPathText}" Classes="settingsMetricMeta"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding SearchStatusMessage}" Classes="hint"/>
                        <TextBlock Text="{Binding SearchMcpMessage}" Classes="hint"/>
                        <TextBlock Text="{Binding SearchLastFailureText}" Classes="hint"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="OVERSIGHT" Classes="navGroupHeader" IsEnabled="False"/>

            <TabItem x:Name="PermissionsTabItem" Header="Permissions" x:CompileBindings="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,36,32" MaxWidth="760" Spacing="22">

                  <StackPanel Spacing="12">
                    <TextBlock Text="LIVE REQUESTS" Classes="sectionLabel"/>

                  <!-- ── Permission Request Card ── -->
                  <Border x:Name="PermissionRequestCard"
                          IsVisible="False"
                          Classes="settingsStatusCard">
                    <StackPanel Spacing="16">
                      <!-- Header -->
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#x1F510;" FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Permission Required"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                      </StackPanel>

                      <!-- Structured fields -->
                      <Border Classes="settingsMetricTile"
                              Padding="16,14">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="14">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="Tool:"
                                     Foreground="{DynamicResource TextTertiary}"
                                     FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock x:Name="PermToolNameText" Grid.Row="0" Grid.Column="1"
                                     Foreground="{StaticResource PeachBrush}"
                                     FontWeight="Bold" FontFamily="Cascadia Mono,Consolas,monospace"
                                     FontSize="13"/>

                          <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:"
                                     Foreground="{DynamicResource TextTertiary}"
                                     FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock x:Name="PermCategoryText" Grid.Row="1" Grid.Column="1"
                                     Foreground="{DynamicResource TextPrimary}"
                                     FontWeight="Bold" FontSize="13"/>

                          <TextBlock Grid.Row="2" Grid.Column="0" Text="What it does:"
                                     Foreground="{DynamicResource TextTertiary}"
                                     FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock x:Name="PermDescriptionText" Grid.Row="2" Grid.Column="1"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontSize="13" TextWrapping="Wrap"/>

                          <TextBlock Grid.Row="3" Grid.Column="0" Text="Details:"
                                     Foreground="{DynamicResource TextTertiary}"
                                     FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock x:Name="PermDetailsText" Grid.Row="3" Grid.Column="1"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontFamily="Cascadia Mono,Consolas,monospace"
                                     FontSize="12" TextWrapping="Wrap"/>
                        </Grid>
                      </Border>

                      <!-- Warning banner -->
                      <Border Background="#1A2A3E"
                              CornerRadius="{StaticResource RadiusSm}"
                              Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="&#x26A0;" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource YellowBrush}"/>
                          <TextBlock x:Name="PermWarningText"
                                     Text="Sir Thaddeus is requesting access to a tool on your behalf."
                                     Foreground="{StaticResource PeachBrush}"
                                     FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>

                      <!-- Action buttons -->
                      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="DenyPermissionButton" Content="Deny"
                                Classes="denyBtn" IsEnabled="False"
                                Click="DenyPermissionButton_Click" Margin="0,0,8,8"/>
                        <Button x:Name="ApprovePermissionButton" Content="Allow once"
                                Classes="allowOnceBtn" IsEnabled="False"
                                Click="ApprovePermissionButton_Click" Margin="0,0,8,8"/>
                        <Button x:Name="AllowSessionButton" Content="Allow for session"
                                Classes="allowSessionBtn" IsEnabled="False"
                                Click="AllowSessionButton_Click" Margin="0,0,8,8"/>
                        <Button x:Name="AllowAlwaysButton" Content="Allow always"
                                Classes="allowAlwaysBtn" IsEnabled="False"
                                Click="AllowAlwaysButton_Click" Margin="0,0,0,8"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <!-- ── No Pending (shown when idle) ── -->
                  <Border x:Name="PermissionIdleCard"
                          IsVisible="True"
                          Classes="settingsCard">
                    <TextBlock x:Name="PermissionSummaryText"
                               Text="No pending permission requests."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                  </Border>

                  </StackPanel>

                  <!-- Hidden payload box for data transfer -->
                  <TextBox x:Name="PermissionPayloadBox" IsVisible="False" IsReadOnly="True"/>

                  <!-- ── MCP Policies ── -->
                  <StackPanel Spacing="10">
                    <TextBlock Text="DEFAULT POLICIES" Classes="sectionLabel"/>
                    <TextBlock Text="Baseline approval posture for each capability." Classes="hint" Margin="0,0,0,4"/>
                    <Border Classes="settingsCard">
                      <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                          <TextBlock Text="Developer override" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding DeveloperOverrideOptions}" SelectedItem="{Binding McpDeveloperOverride}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Surface0Brush}" Opacity="0.4"/>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                          <TextBlock Text="Screen capture" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding PermissionOptions}" SelectedItem="{Binding McpScreen}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Surface0Brush}" Opacity="0.4"/>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                          <TextBlock Text="File system (read &amp; write)" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding PermissionOptions}" SelectedItem="{Binding McpFiles}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Surface0Brush}" Opacity="0.4"/>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                          <TextBlock Text="System commands" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding PermissionOptions}" SelectedItem="{Binding McpSystem}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Surface0Brush}" Opacity="0.4"/>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                          <TextBlock Text="Web navigation &amp; search" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding PermissionOptions}" SelectedItem="{Binding McpWeb}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Surface0Brush}" Opacity="0.4"/>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                          <TextBlock Text="Memory (read)" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding PermissionOptions}" SelectedItem="{Binding McpMemoryRead}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Surface0Brush}" Opacity="0.4"/>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                          <TextBlock Text="Memory (write)" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding PermissionOptions}" SelectedItem="{Binding McpMemoryWrite}" HorizontalAlignment="Stretch"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AuditTabItem" Header="Audit">
              <Grid RowDefinitions="Auto,*" RowSpacing="0">
                <Border Background="{StaticResource CrustBrush}"
                        Padding="48,16,48,12"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button x:Name="RefreshAuditButton" Content="Refresh"
                            Classes="actionBtn" Click="RefreshAuditButton_Click"/>
                    <Button Grid.Column="1" Content="Open Log File"
                            Classes="actionBtn" Click="OpenAuditLogFile_Click"/>
                    <Button Grid.Column="2" Content="Open Folder"
                            Classes="actionBtn" Click="OpenAuditLogFolder_Click"/>
                    <TextBlock Grid.Column="3" Text="AUDIT LOG" Classes="sectionLabel" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Border Grid.Row="1" Margin="24,16,24,24" Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" Padding="4">
                  <ListBox x:Name="AuditList"
                           Background="Transparent"
                           Foreground="{StaticResource TextBrush}"/>
                </Border>
              </Grid>
            </TabItem>

            <TabItem x:Name="MemoryTabItem" Header="Memory">
              <Grid RowDefinitions="Auto,*" RowSpacing="0">
                <Border Background="{StaticResource CrustBrush}"
                        Padding="48,16,48,12"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBox x:Name="MemoryFilterBox"
                             Watermark="Filter memory..."
                             Classes="chatInput"
                             FontSize="13"
                             Padding="12,8"/>
                    <TextBlock Grid.Column="1"
                               x:Name="MemoryStatusText"
                               Text="Memory: not loaded"
                               FontSize="12"
                               Foreground="{StaticResource Overlay0Brush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            x:Name="RefreshMemoryButton"
                            Content="Refresh"
                            Classes="actionBtn"
                            Click="RefreshMemoryButton_Click"/>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Margin="24,16,24,24">
                  <TabControl Background="Transparent" Padding="0,8,0,0">
                    <TabItem Header="Facts">
                      <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" Padding="2">
                        <DataGrid x:Name="MemoryFactsList" AutoGenerateColumns="False" IsReadOnly="False" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" CellEditEnded="MemoryFactsList_CellEditEnded">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Subject" Binding="{ReflectionBinding Subject}" Width="120" />
                            <DataGridTextColumn Header="Predicate" Binding="{ReflectionBinding Predicate}" Width="100" />
                            <DataGridTextColumn Header="Object" Binding="{ReflectionBinding Object}" Width="*" />
                            <DataGridTextColumn Header="Confidence" Binding="{ReflectionBinding Confidence}" Width="80" />
                            <DataGridTextColumn Header="Profile" Binding="{ReflectionBinding ProfileId}" Width="100" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </Border>
                    </TabItem>
                    <TabItem Header="Events">
                      <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" Padding="2">
                        <DataGrid x:Name="MemoryEventsList" AutoGenerateColumns="False" IsReadOnly="False" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" CellEditEnded="MemoryEventsList_CellEditEnded">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{ReflectionBinding Type}" Width="120" />
                            <DataGridTextColumn Header="Title" Binding="{ReflectionBinding Title}" Width="*" />
                            <DataGridTextColumn Header="Summary" Binding="{ReflectionBinding Summary}" Width="150" />
                            <DataGridTextColumn Header="Confidence" Binding="{ReflectionBinding Confidence}" Width="80" />
                            <DataGridTextColumn Header="Profile" Binding="{ReflectionBinding ProfileId}" Width="100" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </Border>
                    </TabItem>
                    <TabItem Header="Chunks">
                      <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" Padding="2">
                        <DataGrid x:Name="MemoryChunksList" AutoGenerateColumns="False" IsReadOnly="False" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" CellEditEnded="MemoryChunksList_CellEditEnded">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Source Type" Binding="{ReflectionBinding SourceType}" Width="100" />
                            <DataGridTextColumn Header="Source Ref" Binding="{ReflectionBinding SourceRef}" Width="120" />
                            <DataGridTextColumn Header="Text" Binding="{ReflectionBinding Text}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </Border>
                    </TabItem>
                    <TabItem Header="Nuggets">
                      <Border Background="{StaticResource MantleBrush}" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" Padding="2">
                        <DataGrid x:Name="MemoryNuggetsList" AutoGenerateColumns="False" IsReadOnly="False" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" CellEditEnded="MemoryNuggetsList_CellEditEnded">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Text" Binding="{ReflectionBinding Text}" Width="*" />
                            <DataGridTextColumn Header="Tags" Binding="{ReflectionBinding Tags}" Width="120" />
                            <DataGridTextColumn Header="Weight" Binding="{ReflectionBinding Weight}" Width="80" />
                            <DataGridTextColumn Header="Pin Lvl" Binding="{ReflectionBinding PinLevel}" Width="60" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </Border>
                    </TabItem>
                  </TabControl>
                </Border>
              </Grid>
            </TabItem>

            <TabItem Header="PERSONAL" Classes="navGroupHeader" IsEnabled="False"/>

            <TabItem x:Name="ProfilesTabItem" Header="Profiles">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
                <Border Background="{StaticResource CrustBrush}"
                        Padding="48,16,48,12"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button x:Name="RefreshProfilesButton"
                            Content="Refresh"
                            Classes="actionBtn"
                            Click="RefreshProfilesButton_Click"/>
                    <TextBlock Grid.Column="1"
                               x:Name="ProfilesStatusText"
                               Text="Profiles: not loaded"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Overlay0Brush}"/>
                  </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24,16,24,16" ColumnDefinitions="*,16,*">
                  <!-- Memory Profiles -->
                  <Border Background="{StaticResource MantleBrush}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource RadiusMd}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="16">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Memory Profiles" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Your user and person memory cards."
                                   Classes="hint"/>
                      </StackPanel>
                      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="AddProfileButton"
                                Content="Add"
                                Classes="actionBtn"
                                Click="AddProfileButton_Click"/>
                        <Button x:Name="EditProfileButton"
                                Content="Edit"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="EditProfileButton_Click"/>
                        <Button x:Name="DeleteProfileButton"
                                Content="Delete"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="DeleteProfileButton_Click"/>
                        <Button x:Name="SetActiveProfileButton"
                                Content="Set Active"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="SetActiveProfileButton_Click"/>
                      </StackPanel>
                      <Border Grid.Row="2" CornerRadius="{StaticResource RadiusSm}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" Padding="2">
                        <DataGrid x:Name="ProfilesList"
                                  SelectionChanged="ProfilesList_SelectionChanged"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Profile" Binding="{ReflectionBinding DisplayName}" Width="160"/>
                            <DataGridTextColumn Header="Details" Binding="{ReflectionBinding Meta}" Width="*"/>
                          </DataGrid.Columns>
                        </DataGrid>
                      </Border>
                    </Grid>
                  </Border>

                  <!-- Personalities -->
                  <Border Grid.Column="2"
                          Background="{StaticResource MantleBrush}"
                          BorderBrush="{StaticResource Surface0Brush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource RadiusMd}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="16">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Personalities" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Assistant behavior profiles."
                                   Classes="hint"/>
                      </StackPanel>
                      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="AddPersonalityButton"
                                Content="Add"
                                Classes="actionBtn"
                                Click="AddPersonalityButton_Click"/>
                        <Button x:Name="EditPersonalityButton"
                                Content="Edit"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="EditPersonalityButton_Click"/>
                        <Button x:Name="DeletePersonalityButton"
                                Content="Delete"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="DeletePersonalityButton_Click"/>
                        <Button x:Name="SetActivePersonalityButton"
                                Content="Set Active"
                                Classes="actionBtn"
                                IsEnabled="False"
                                Click="SetActivePersonalityButton_Click"/>
                      </StackPanel>
                      <Border Grid.Row="2" CornerRadius="{StaticResource RadiusSm}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" Padding="2">
                        <DataGrid x:Name="PersonalitiesList"
                                  SelectionChanged="PersonalitiesList_SelectionChanged"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Personality" Binding="{ReflectionBinding DisplayName}" Width="160"/>
                            <DataGridTextColumn Header="Details" Binding="{ReflectionBinding Meta}" Width="*"/>
                          </DataGrid.Columns>
                        </DataGrid>
                      </Border>
                    </Grid>
                  </Border>
                </Grid>

                <Border Grid.Row="2" Padding="48,0,48,16">
                  <TextBlock Text="Add opens a starter JSON document. Edit loads the current JSON. Active items are selected automatically when the tab refreshes."
                             Classes="hint"/>
                </Border>
              </Grid>
            </TabItem>
            </TabControl>

            <Border Grid.Column="1"
                    Classes="settingsPaneSurface"
                    x:CompileBindings="False">
              <Grid RowDefinitions="Auto,*"
                    ClipToBounds="True">
                <Border Classes="settingsPaneHeader">
                  <TextBlock Text="{Binding SelectedItem.Header, ElementName=SettingsTabControl}"
                             Classes="settingsPaneTitle"/>
                </Border>
                <ContentControl Grid.Row="1"
                                Content="{Binding SelectedContent, ElementName=SettingsTabControl}"
                                ContentTemplate="{Binding SelectedContentTemplate, ElementName=SettingsTabControl}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- ── Progress Drawer (workflow checklist / narration) ── -->
      <Border x:Name="ProgressDrawer"
              Grid.Column="1"
              Width="260"
              IsVisible="False"
              Background="{DynamicResource BackgroundSecondary}"
              BorderBrush="{DynamicResource BorderMuted}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" Margin="12,12,12,8" ColumnDefinitions="*,Auto">
            <TextBlock Text="Progress" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Classes="headerBtn" Click="CloseProgressDrawerButton_Click"/>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,0,12,12" Spacing="12">
              <Border Classes="progressRailSummaryCard"
                      Padding="12,10">
                <StackPanel Spacing="6">
                  <TextBlock Text="Current run"
                             Classes="progressRailSectionHeader"/>
                  <TextBlock x:Name="WorkflowNarrationText"
                             Text=""
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}"
                             TextWrapping="Wrap"/>
                  <TextBlock x:Name="WorkflowToolStripText"
                             Text=""
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondary}"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <TextBlock Text="Timeline"
                         Classes="progressRailSectionHeader"/>

              <ItemsControl x:Name="WorkflowChecklistList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WorkflowChecklistItemViewModel">
                    <Border Classes="progressRailItemCard"
                            Margin="0,0,0,6"
                            Padding="10,9">
                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">
                        <Border Classes="progressRailStateShell"
                                Width="24"
                                Height="24">
                          <TextBlock Text="{Binding StateIcon}"
                                     FontSize="12"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Spacing="3">
                          <TextBlock Text="{Binding Title}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimary}"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding StatusNote}"
                                     IsVisible="{Binding StatusNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextSecondary}"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border x:Name="ActionDrawer"
              Grid.Column="1"
              Width="280"
              IsVisible="False"
              Background="{DynamicResource BackgroundPrimary}"
              BorderBrush="{DynamicResource BorderMuted}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <!-- Header -->
          <Grid Grid.Row="0" Margin="12,12,12,8" ColumnDefinitions="*,Auto">
            <TextBlock Text="Activity" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Classes="headerBtn" Click="CloseActionDrawerButton_Click"/>
          </Grid>

          <ScrollViewer Grid.Row="1"
                        Margin="12,0,12,12"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">

              <!-- ═══ Connection Status Card ═══ -->
              <Border Classes="activityRailSummaryCard" Padding="10,8">
                <StackPanel Spacing="8">
                  <Border Background="{StaticResource Surface0Brush}" CornerRadius="999" Padding="8,3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border x:Name="ActionConnectionDot"
                              Width="7" Height="7" CornerRadius="999"
                              Background="{StaticResource Overlay0Brush}"
                              VerticalAlignment="Center"/>
                      <TextBlock x:Name="ActionConnectionStateText"
                                 Text="Disconnected"
                                 FontSize="11" FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="ActionRuntimeSummaryText"
                               Text="Local runtime unavailable"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ActionRuntimeStateText"
                               Text="Managed runtime not running"
                               FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <Button x:Name="ActionRuntimeDetailsButton"
                            Classes="activityRailDisclosureButton"
                            Click="ActionRuntimeDetailsButton_Click">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="Connection details"
                                   Classes="activityRailDisclosureLabel"
                                   VerticalAlignment="Center"/>
                        <ic:SymbolIcon x:Name="ActionRuntimeDetailsChevron"
                                       Grid.Column="1" Symbol="ChevronDown"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                      </Grid>
                    </Button>
                    <Border x:Name="ActionRuntimeDetailsPanel"
                            Classes="activityRailInlineDetailPanel"
                            IsVisible="False" Padding="8,8">
                      <StackPanel Spacing="8">
                        <TextBlock x:Name="ActionRuntimeEndpointText"
                                   Text="No endpoint configured"
                                   Classes="activityRailValue" TextWrapping="Wrap"/>
                        <Button Content="Copy endpoint"
                                HorizontalAlignment="Left"
                                Classes="headerBtn"
                                Click="ActionCopyEndpointButton_Click"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- ═══ Session Summary ═══ -->
              <Border Classes="activityRailPanel">
                <StackPanel Spacing="6">
                  <TextBlock Text="Session Summary"
                             Classes="activityRailSectionHeader"/>
                  <TextBlock x:Name="SessionSummaryText"
                             Text="No tool calls this session"
                             FontSize="12" Foreground="{DynamicResource TextSecondary}"
                             TextWrapping="Wrap"/>
                  <TextBlock x:Name="SessionTimeRangeText"
                             FontSize="10" Foreground="{DynamicResource TextTertiary}"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- ═══ Tool Categories (expandable) ═══ -->
              <Border Classes="activityRailPanel">
                <StackPanel Spacing="6">
                  <TextBlock Text="Tool Activity"
                             Classes="activityRailSectionHeader"/>
                  <ItemsControl x:Name="CategoryList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="activityRailItemCard" Padding="8,6" Margin="0,0,0,4" CornerRadius="6">
                          <StackPanel Spacing="4">
                            <!-- Category header row -->
                            <Button Classes="activityRailDisclosureButton"
                                    Click="CategoryExpandButton_Click"
                                    Tag="{ReflectionBinding CategoryKey}">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{ReflectionBinding DisplayName}"
                                             FontSize="12" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimary}"/>
                                  <TextBlock Text="{ReflectionBinding Summary}"
                                             FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{ReflectionBinding LastCallTime}"
                                           FontSize="10" Foreground="{DynamicResource TextTertiary}"
                                           VerticalAlignment="Top"/>
                              </Grid>
                            </Button>
                            <!-- Expanded call list -->
                            <ItemsControl ItemsSource="{ReflectionBinding RecentCalls}"
                                          IsVisible="{ReflectionBinding IsExpanded}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Padding="4,3" Margin="8,2,0,0"
                                          BorderBrush="{DynamicResource BorderMuted}"
                                          BorderThickness="0,0,0,1"
                                          ToolTip.Tip="{ReflectionBinding TooltipText}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                      <Border Width="4" Height="4" CornerRadius="999"
                                              Background="{ReflectionBinding AccentBrush}"
                                              VerticalAlignment="Center" Margin="0,0,2,0"/>
                                      <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{ReflectionBinding DisplayName}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{ReflectionBinding InputSummary}"
                                                   FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Top">
                                        <TextBlock Text="{ReflectionBinding DurationText}"
                                                   FontSize="9" Foreground="{DynamicResource TextTertiary}"
                                                   HorizontalAlignment="Right"/>
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- ═══ MCP Connections ═══ -->
              <Border Classes="activityRailPanel">
                <StackPanel Spacing="6">
                  <TextBlock Text="MCP Connections"
                             Classes="activityRailSectionHeader"/>
                  <ItemsControl x:Name="ConnectionList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="activityRailItemCard" Padding="8,6" Margin="0,0,0,4" CornerRadius="6"
                                ToolTip.Tip="{ReflectionBinding TooltipText}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{ReflectionBinding DisplayName}"
                                         FontSize="12" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimary}"/>
                              <TextBlock Text="{ReflectionBinding CallsSummary}"
                                         FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="activityRailStatusBadge"
                                    VerticalAlignment="Top">
                              <TextBlock Text="{ReflectionBinding ApprovalLabel}"
                                         FontSize="10" FontWeight="SemiBold"
                                         Foreground="{ReflectionBinding ApprovalBrush}"/>
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- ═══ Selected Call Detail ═══ -->
              <Border x:Name="SelectedCallDetailPanel"
                      Classes="activityRailPanel"
                      IsVisible="False">
                <StackPanel Spacing="8">
                  <TextBlock Text="Call Detail"
                             Classes="activityRailSectionHeader"/>
                  <Border Classes="activityRailDetailCard" Padding="10,10">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="CallDetailHeadingText"
                                   Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        <Border Grid.Column="1" Classes="activityRailStatusBadge">
                          <TextBlock x:Name="CallDetailStatusText" Text=""
                                     FontSize="10" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextSecondary}"/>
                        </Border>
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            ColumnSpacing="10" RowSpacing="6">
                        <TextBlock Text="Tool" Classes="activityRailKey"/>
                        <TextBlock x:Name="CallDetailToolText" Grid.Column="1"
                                   Classes="activityRailValue" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Text="Input" Classes="activityRailKey"/>
                        <TextBlock x:Name="CallDetailInputText" Grid.Row="1" Grid.Column="1"
                                   Classes="activityRailValue" TextWrapping="Wrap"
                                   MaxLines="3" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="2" Text="Output" Classes="activityRailKey"/>
                        <TextBlock x:Name="CallDetailOutputText" Grid.Row="2" Grid.Column="1"
                                   Classes="activityRailValue" TextWrapping="Wrap"
                                   MaxLines="3" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="3" Text="Permission" Classes="activityRailKey"/>
                        <TextBlock x:Name="CallDetailPermissionText" Grid.Row="3" Grid.Column="1"
                                   Classes="activityRailValue" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="4" Text="Duration" Classes="activityRailKey"/>
                        <TextBlock x:Name="CallDetailDurationText" Grid.Row="4" Grid.Column="1"
                                   Classes="activityRailValue"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Button HorizontalAlignment="Left"
                      Content="Open full audit"
                      Classes="headerBtn"
                      Click="ActionOpenAuditTabButton_Click"/>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    </Grid>

    <Border Grid.Row="2" x:Name="InputBar"
            Background="{DynamicResource BackgroundPrimary}"
        BorderBrush="{DynamicResource BorderMuted}"
      Padding="24,8,24,16"
        BorderThickness="0,1,0,0">
      <Grid x:Name="InputBarLayout" MaxWidth="820" HorizontalAlignment="Stretch" RowDefinitions="Auto,Auto" RowSpacing="6">
        <Border Background="{DynamicResource BackgroundSecondary}"
                BorderBrush="{DynamicResource BorderMuted}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,8"
                IsVisible="False"
        Grid.Row="0"
                HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border x:Name="PttStateBadge"
                    Background="{DynamicResource BorderMuted}"
                    CornerRadius="999"
                    Padding="10,4"
                    VerticalAlignment="Top">
              <TextBlock x:Name="PttStateText"
                         Text="READY"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimary}"/>
            </Border>

            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock x:Name="PttStatusText"
                         Text="Voice ready. Hold Talk or press Ctrl+Alt+M."
                         FontSize="11"
                         Foreground="{DynamicResource TextPrimary}"
                         TextWrapping="Wrap"/>
              <TextBlock x:Name="PttDetailText"
                         Text="Preparing voice controls."
                         FontSize="10"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <local:ChatInputBar x:Name="ChatComposer"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"/>
      </Grid>
    </Border>
  </Grid>
</Window>
