<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Single File / Self Contained Optimizations -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' != 'true'">false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\packages\core\SirThaddeus.Core\SirThaddeus.Core.csproj" />
  </ItemGroup>

  <!-- Optional bundled backend sidecar (preferred publish layout: ./voice/) -->
  <ItemGroup Condition="Exists('..\..\voice-backend\dist\voice-backend.exe')">
    <None Include="..\..\voice-backend\dist\voice-backend.exe"
          Link="voice\voice-backend.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Dev fallback assets; harmless in release when binary sidecar exists -->
  <ItemGroup Condition="Exists('..\..\voice-backend\server.py')">
    <None Include="..\..\voice-backend\server.py"
          Link="voice\server.py"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\start-voice-backend.ps1')">
    <None Include="..\..\voice-backend\start-voice-backend.ps1"
          Link="voice\start-voice-backend.ps1"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\model_downloader.py')">
    <None Include="..\..\voice-backend\model_downloader.py"
          Link="voice\model_downloader.py"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\youtube_pipeline.py')">
    <None Include="..\..\voice-backend\youtube_pipeline.py"
          Link="voice\youtube_pipeline.py"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\model_registry.json')">
    <None Include="..\..\voice-backend\model_registry.json"
          Link="voice\model_registry.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\requirements.txt')">
    <None Include="..\..\voice-backend\requirements.txt"
          Link="voice\requirements.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Piper voice catalog (lists all available en_US voices with download URLs) -->
  <ItemGroup Condition="Exists('..\..\voice-backend\piper_voice_catalog.json')">
    <None Include="..\..\voice-backend\piper_voice_catalog.json"
          Link="voice\piper_voice_catalog.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy Piper TTS dependencies if present -->
  <ItemGroup Condition="Exists('..\..\voice-backend\piper')">
    <None Include="..\..\voice-backend\piper\**\*.*"
          Link="voice\piper\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\piper-voices')">
    <None Include="..\..\voice-backend\piper-voices\**\*.*"
          Link="voice\piper-voices\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>


</Project>
