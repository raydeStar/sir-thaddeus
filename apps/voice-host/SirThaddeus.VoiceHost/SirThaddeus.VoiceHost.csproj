<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Single File / Self Contained Optimizations -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Optional bundled backend sidecar (preferred publish layout: ./voice/) -->
  <ItemGroup Condition="Exists('..\..\voice-backend\dist\voice-backend.exe')">
    <None Include="..\..\voice-backend\dist\voice-backend.exe"
          Link="voice\voice-backend.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Dev fallback assets; harmless in release when binary sidecar exists -->
  <ItemGroup Condition="Exists('..\..\voice-backend\server.py')">
    <None Include="..\..\voice-backend\server.py"
          Link="voice\server.py"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\start-voice-backend.ps1')">
    <None Include="..\..\voice-backend\start-voice-backend.ps1"
          Link="voice\start-voice-backend.ps1"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\model_downloader.py')">
    <None Include="..\..\voice-backend\model_downloader.py"
          Link="voice\model_downloader.py"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\youtube_pipeline.py')">
    <None Include="..\..\voice-backend\youtube_pipeline.py"
          Link="voice\youtube_pipeline.py"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\model_registry.json')">
    <None Include="..\..\voice-backend\model_registry.json"
          Link="voice\model_registry.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\requirements.txt')">
    <None Include="..\..\voice-backend\requirements.txt"
          Link="voice\requirements.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Pre-bundled Kokoro TTS voice assets (default voice: bm_lewis).
       These are ~337 MB and gitignored, but present after a first local run.
       Bundling them eliminates the largest cold-start download on fresh machines.
       Other voices are downloaded on-demand when the user switches. -->
  <ItemGroup Condition="Exists('..\..\voice-backend\voices\bm_lewis\model.onnx')">
    <None Include="..\..\voice-backend\voices\bm_lewis\model.onnx"
          Link="voice\voices\bm_lewis\model.onnx"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\voices\bm_lewis\voices.bin')">
    <None Include="..\..\voice-backend\voices\bm_lewis\voices.bin"
          Link="voice\voices\bm_lewis\voices.bin"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\voices\bm_lewis\manifest.json')">
    <None Include="..\..\voice-backend\voices\bm_lewis\manifest.json"
          Link="voice\voices\bm_lewis\manifest.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\voice-backend\voices\README.md')">
    <None Include="..\..\voice-backend\voices\README.md"
          Link="voice\voices\README.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
