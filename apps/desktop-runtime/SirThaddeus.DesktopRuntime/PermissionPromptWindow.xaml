<Window x:Class="SirThaddeus.DesktopRuntime.PermissionPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Permission Required"
        Width="560"
        Height="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="{DynamicResource BaseBrush}"
        Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🔐" FontSize="24" Margin="0,0,12,0"/>
            <TextBlock Text="Permission Required" 
                       FontSize="20" 
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Request Summary -->
        <Border Grid.Row="1" 
                Background="{DynamicResource Surface0Brush}"
                CornerRadius="4"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Capability:" 
                           Foreground="{DynamicResource Subtext0Brush}"
                           FontWeight="SemiBold" Margin="0,0,12,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" 
                           x:Name="CapabilityText"
                           Foreground="{DynamicResource PeachBrush}"
                           FontWeight="Bold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Purpose:" 
                           Foreground="{DynamicResource Subtext0Brush}"
                           FontWeight="SemiBold" Margin="0,0,12,8"/>
                <TextBlock Grid.Row="1" Grid.Column="1" 
                           x:Name="PurposeText"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Scope:" 
                           Foreground="{DynamicResource Subtext0Brush}"
                           FontWeight="SemiBold" Margin="0,0,12,8"/>
                <TextBlock Grid.Row="2" Grid.Column="1" 
                           x:Name="ScopeText"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration:" 
                           Foreground="{DynamicResource Subtext0Brush}"
                           FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" 
                           x:Name="DurationText"/>
            </Grid>
        </Border>

        <!-- Warning -->
        <Border Grid.Row="2" 
                Background="#2D2A3E"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                <TextBlock Text="This action will grant the specified capability. Review carefully."
                           Foreground="{DynamicResource PeachBrush}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Deny" 
                    Style="{DynamicResource DenyButtonStyle}"
                    Click="DenyButton_Click"
                    Margin="0,0,8,0"/>
            <Button Content="Allow once" 
                    Style="{DynamicResource AllowOnceButtonStyle}"
                    Click="AllowOnceButton_Click"
                    Margin="0,0,8,0"/>
            <Button Content="Allow for session" 
                    Style="{DynamicResource AllowSessionButtonStyle}"
                    Click="AllowSessionButton_Click"
                    Margin="0,0,8,0"/>
            <Button Content="Allow always" 
                    Style="{DynamicResource AllowAlwaysButtonStyle}"
                    Click="AllowAlwaysButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
