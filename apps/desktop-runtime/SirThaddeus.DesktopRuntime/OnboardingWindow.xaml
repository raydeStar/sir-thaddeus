<Window x:Class="SirThaddeus.DesktopRuntime.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sir Thaddeus — Setup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Width="560" Height="490">

    <!-- ── Resources MUST be declared before content in WPF ─────── -->
    <Window.Resources>
        <DropShadowEffect x:Key="WizardShadow"
                          Color="#000000" BlurRadius="32"
                          ShadowDepth="0" Opacity="0.6" Direction="0"/>

        <Style x:Key="StepDotActive" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#4C8BF5"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="StepDotInactive" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="#363E52"/>
            <Setter Property="Margin" Value="5,1"/>
        </Style>

        <Style x:Key="WizardInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E232E"/>
            <Setter Property="Foreground" Value="#DFE5F2"/>
            <Setter Property="CaretBrush" Value="#4C8BF5"/>
            <Setter Property="BorderBrush" Value="#282F3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="SelectionBrush" Value="#4C8BF5"/>
        </Style>

        <Style x:Key="ProviderRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DFE5F2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#161A22"
                                CornerRadius="8" Padding="14,12"
                                BorderBrush="#282F3E" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C8BF5"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1A2240"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E232E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WizardPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4C8BF5"/>
            <Setter Property="Foreground" Value="#0B0D12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5DA1F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#282F3E"/>
                                <Setter Property="Foreground" Value="#4A556B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WizardGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA8C2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E232E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ── Fade-in on load ──────────────────────────────────────── -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#0B0D12"
            CornerRadius="16"
            BorderBrush="#1E232E"
            BorderThickness="1"
            Effect="{StaticResource WizardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ────────────────────────────────────────── -->
            <StackPanel Grid.Row="0" Margin="32,24,32,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Image x:Name="AppIcon"
                           Width="28" Height="28" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Sir Thaddeus Setup"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#DFE5F2" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Step dots -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Ellipse x:Name="Dot1" Style="{StaticResource StepDotActive}"/>
                    <Ellipse x:Name="Dot2" Style="{StaticResource StepDotInactive}"/>
                    <Ellipse x:Name="Dot3" Style="{StaticResource StepDotInactive}"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Step 1: Connect LLM ───────────────────────────── -->
            <Grid x:Name="Step1Panel" Grid.Row="1" Margin="32,16,32,0">
                <StackPanel>
                    <TextBlock Text="Connect your LLM"
                               FontSize="16" FontWeight="SemiBold" Foreground="#DFE5F2"
                               Margin="0,0,0,4"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                    <TextBlock Text="Select which local AI backend you're running."
                               FontSize="13" Foreground="#9AA8C2" Margin="0,0,0,16"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                        <StackPanel x:Name="ProviderList"/>
                    </ScrollViewer>

                    <TextBlock x:Name="ConnectionStatus"
                               FontSize="12" Foreground="#9AA8C2" Margin="0,12,0,0"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                </StackPanel>
            </Grid>

            <!-- ── Step 2: Who Are You? ──────────────────────────── -->
            <Grid x:Name="Step2Panel" Grid.Row="1" Margin="32,16,32,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Who are you?"
                               FontSize="16" FontWeight="SemiBold" Foreground="#DFE5F2"
                               Margin="0,0,0,4"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                    <TextBlock Text="So I know who I'm working with."
                               FontSize="13" Foreground="#9AA8C2" Margin="0,0,0,20"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>

                    <TextBlock Text="What should I call you?"
                               FontSize="13" Foreground="#B8C5DE" Margin="0,0,0,6"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                    <TextBox x:Name="DisplayNameInput"
                             Style="{StaticResource WizardInputStyle}"
                             MaxLength="60" Margin="0,0,0,20"/>

                    <TextBlock Text="Tell me a bit about yourself (optional)"
                               FontSize="13" Foreground="#B8C5DE" Margin="0,0,0,6"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                    <TextBox x:Name="AboutMeInput"
                             Style="{StaticResource WizardInputStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="110" MaxLength="500"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>

            <!-- ── Step 3: Pick a Personality ─────────────────────── -->
            <Grid x:Name="Step3Panel" Grid.Row="1" Margin="32,16,32,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Pick a personality"
                               FontSize="16" FontWeight="SemiBold" Foreground="#DFE5F2"
                               Margin="0,0,0,4"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                    <TextBlock Text="Choose how your assistant communicates."
                               FontSize="13" Foreground="#9AA8C2" Margin="0,0,0,16"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>

                    <RadioButton x:Name="PersonalitySirThaddeus"
                                 Style="{StaticResource ProviderRadioStyle}"
                                 IsChecked="True" GroupName="Personality">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sir Thaddeus" FontWeight="SemiBold"
                                           Foreground="#DFE5F2" FontSize="14"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                <Border Background="#1A2F5A" CornerRadius="4"
                                        Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Recommended" FontSize="10"
                                               Foreground="#4C8BF5" FontWeight="Medium"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Witty, pragmatic, calm guide that stays grounded and trustworthy."
                                       FontSize="12" Foreground="#9AA8C2" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="PersonalityProfessional"
                                 Style="{StaticResource ProviderRadioStyle}"
                                 GroupName="Personality">
                        <StackPanel>
                            <TextBlock Text="Professional" FontWeight="SemiBold"
                                       Foreground="#DFE5F2" FontSize="14"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                            <TextBlock Text="Formal, structured, business-appropriate responses."
                                       FontSize="12" Foreground="#9AA8C2" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="PersonalityDefault"
                                 Style="{StaticResource ProviderRadioStyle}"
                                 GroupName="Personality">
                        <StackPanel>
                            <TextBlock Text="Helpful Default" FontWeight="SemiBold"
                                       Foreground="#DFE5F2" FontSize="14"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                            <TextBlock Text="Clean, minimal, no personality flavor — just the facts."
                                       FontSize="12" Foreground="#9AA8C2" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>

            <!-- ── Navigation ─────────────────────────────────────── -->
            <Grid Grid.Row="2" Margin="32,12,32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0"
                        Content="← Back"
                        Style="{StaticResource WizardGhostButton}"
                        Click="OnBackClick"
                        Visibility="Collapsed"/>

                <Button x:Name="NextButton" Grid.Column="2"
                        Content="Next →"
                        Style="{StaticResource WizardPrimaryButton}"
                        Click="OnNextClick"/>

                <Button x:Name="LetsGoButton" Grid.Column="2"
                        Content="Let's Go!"
                        Style="{StaticResource WizardPrimaryButton}"
                        Click="OnLetsGoClick"
                        Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
