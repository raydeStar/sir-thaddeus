<UserControl x:Class="SirThaddeus.DesktopRuntime.Views.BriefingCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SirThaddeus.DesktopRuntime.Views"
             mc:Ignorable="d">
    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource Surface1Brush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="0,0,0,10">
        <StackPanel>
            <!-- Card header -->
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right"
                        Background="{DynamicResource SubtleBadgeBgBrush}"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="8,0,0,0">
                    <TextBlock Text="{Binding Type}"
                               FontSize="10"
                               Foreground="{DynamicResource Subtext0Brush}"
                               FontWeight="Medium" />
                </Border>
            </DockPanel>

            <!-- Separator -->
            <Border BorderBrush="{DynamicResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Margin="0,8,0,8" />

            <!-- Bullet items -->
            <ItemsControl ItemsSource="{Binding Bullets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" Margin="0,0,0,5">
                            <TextBlock Text="&#x2022;"
                                       Foreground="{DynamicResource BlueBrush}"
                                       FontSize="12"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Top" />
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Subtext1Brush}"
                                       FontSize="12"
                                       LineHeight="18" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sources flyout -->
            <views:SourcesFlyout DataContext="{Binding Sources}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
