<Window x:Class="SirThaddeus.DesktopRuntime.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sir Thaddeus"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Width="420" Height="280">

    <!-- ── Resources MUST come before content ─────────────────── -->
    <Window.Resources>
        <DropShadowEffect x:Key="SplashDropShadow"
                          Color="#000000"
                          BlurRadius="32"
                          ShadowDepth="0"
                          Opacity="0.6"
                          Direction="0"/>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360"
                                     Duration="0:0:0.9"
                                     RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#0B0D12"
            CornerRadius="16"
            BorderBrush="#1E232E"
            BorderThickness="1"
            Padding="0"
            Effect="{StaticResource SplashDropShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main content area -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- App icon -->
                <Image x:Name="AppIcon"
                       Width="56" Height="56"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

                <!-- Title -->
                <TextBlock Text="Sir Thaddeus"
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#DFE5F2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Spinner + Status -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <!-- Rotating arc spinner -->
                    <Canvas Width="18" Height="18"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation"
                                             CenterX="9" CenterY="9"
                                             Angle="0"/>
                        </Canvas.RenderTransform>
                        <Path Stroke="#4C8BF5"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="9,1.5" IsClosed="False">
                                        <ArcSegment Point="1.5,9"
                                                    Size="7.5,7.5"
                                                    SweepDirection="Clockwise"
                                                    IsLargeArc="False"/>
                                        <ArcSegment Point="9,16.5"
                                                    Size="7.5,7.5"
                                                    SweepDirection="Clockwise"
                                                    IsLargeArc="False"/>
                                        <ArcSegment Point="16.5,9"
                                                    Size="7.5,7.5"
                                                    SweepDirection="Clockwise"
                                                    IsLargeArc="False"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Canvas>

                    <!-- Status text -->
                    <TextBlock x:Name="StatusText"
                               Text="Starting…"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               FontSize="13"
                               Foreground="#9AA8C2"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="1"
                       Text="No silent background agents. No hidden telemetry. Just tools you control."
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                       FontSize="11"
                       Foreground="#4A556B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>
        </Grid>
    </Border>
</Window>
