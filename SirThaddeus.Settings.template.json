{
  "llm": {
    "baseUrl": "http://localhost:1234",
    "model": "local-model",
    "maxTokens": 2048,
    "contextWindowTokens": 8192,
    "temperature": 0.7
  },
  "mcp": {
    "serverPath": "auto"
  },
  "audio": {
    "ttsEnabled": true
  },
  "memory": {
    "enabled": true,
    "dbPath": "auto"
  },
  "webSearch": {
    "mode": "auto",
    "searxngBaseUrl": "http://localhost:8080",
    "searxngAutoStart": true,
    "searxngLaunchCommand": "auto",
    "searxngLaunchArguments": "auto",
    "searxngStartupTimeoutMs": 120000,
    "searchApiProvider": "searchapi",
    "searchApiKey": "",
    "searchApiBaseUrl": "https://www.searchapi.io/api/v1/search",
    "searchApiEngine": "google",
    "timeoutMs": 8000,
    "maxResults": 5
  },
  "cache": {
    "enabled": true,
    "webSearchTtlMinutes": 15,
    "weatherTtlMinutes": 60,
    "placesAndHolidaysTtlHours": 24,
    "maxEntries": 500
