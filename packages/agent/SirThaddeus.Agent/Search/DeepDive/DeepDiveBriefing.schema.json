{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sir-thaddeus.local/schema/deep-dive-briefing-v1.json",
  "title": "DeepDiveBriefing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "topic",
    "hero",
    "cards"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "query",
        "timezone",
        "locale"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [ "place", "product" ]
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "userLocationHint": {
          "type": [ "string", "null" ]
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "confidence",
        "lastCheckedIso"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "enum": [ "high", "medium", "low" ] },
        "lastCheckedIso": { "type": "string", "format": "date-time" },
        "statusLine": { "type": "string" },
        "closesText": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" },
        "directionsUrl": { "type": "string" }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "type", "title", "bullets", "sources" ],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "name", "url", "fetchedIso" ],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "fetchedIso": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    },
    "map": {
      "type": [ "object", "null" ],
      "additionalProperties": false,
      "required": [ "latitude", "longitude" ],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "label": { "type": "string" }
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "step", "detail", "timestampIso", "sources" ],
        "properties": {
          "step": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 },
          "timestampIso": { "type": "string", "format": "date-time" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "name", "url", "fetchedIso" ],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "fetchedIso": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    }
  }
}
