<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Force transitive NuGet dependencies (e.g. NCalc) to copy into
         this assembly's bin/ so downstream class libraries and exes
         pick them up. Without this, class libraries don't copy package
         assemblies to their own output, so the chain
         Agent → Runtime / HeadlessRuntime silently drops NCalc and
         throws "Could not load assembly NCalc.Sync" at first use of
         the advanced calculator. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SirThaddeus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\llm-client\SirThaddeus.LlmClient\SirThaddeus.LlmClient.csproj" />
    <ProjectReference Include="..\..\audit-log\SirThaddeus.AuditLog\SirThaddeus.AuditLog.csproj" />
    <ProjectReference Include="..\..\config\SirThaddeus.Config\SirThaddeus.Config.csproj" />
    <ProjectReference Include="..\..\personality-engine\SirThaddeus.PersonalityEngine\SirThaddeus.PersonalityEngine.csproj" />
    <ProjectReference Include="..\..\memory\SirThaddeus.Memory\SirThaddeus.Memory.csproj" />
    <ProjectReference Include="..\..\web-search\SirThaddeus.WebSearch\SirThaddeus.WebSearch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.7" />
    <PackageReference Include="NCalcSync" Version="6.3.2" />
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>

</Project>
