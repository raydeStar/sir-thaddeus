# Common local caches / envs
node_modules/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# ML model artifacts — auto-downloaded on voice-backend startup.
# These are too large for version control; see model_registry.json
# for canonical download URLs and SHA256 verification hashes.
*.onnx
!apps/voice-backend/voices/*/*.onnx
!apps/voice-backend/piper-voices/**/*.onnx
*.safetensors
# Keep generated voice cache files ignored.
apps/voice-backend/voices/*/*.npy
apps/voice-backend/voices/*/*.json
!apps/voice-backend/voices/*/manifest.json
# Vendored voice backend dependencies/assets (tracked via Git LFS).
!apps/voice-backend/voices/*/*.bin
!apps/voice-backend/bin/uv.exe
apps/voice-backend/bin/uvx.exe
!apps/voice-backend/deps/wheels/*.whl
!apps/voice-backend/runtime/python/**
# STT models downloaded at runtime — do NOT commit the HuggingFace cache.
apps/voice-backend/stt-models/.locks/
apps/voice-backend/stt-models/models--*/
# Piper TTS native binary + voice models (bundled).
!apps/voice-backend/piper/
!apps/voice-backend/piper-voices/
apps/voice-backend/.seed-*/
packages/requested-files.zip

# Generated YouTube transcript jobs (runtime output)
data/youtube/
apps/voice-backend/data/youtube/
.cursor/rules/oss-comments.mdc
apps/voice-backend/output.log
apps/voice-backend/output_utf8.log
