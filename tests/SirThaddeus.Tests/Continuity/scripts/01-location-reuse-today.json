{
  "id": "01-location-reuse-today",
  "description": "Location set, then today follow-up reuses location.",
  "llm": {
    "mode": "never",
    "fixedResponse": "LLM should not be called"
  },
  "mcp": {
    "mode": "perTool",
    "fixedValue": "unexpected tool call",
    "perTool": {
      "weather_geocode": {
        "defaultResponse": "{\"query\":\"Seattle, WA\",\"source\":\"photon\",\"cache\":{\"hit\":false,\"ageSeconds\":0},\"results\":[{\"name\":\"Seattle, Washington, US\",\"regionCode\":\"WA\",\"countryCode\":\"US\",\"isUs\":true,\"latitude\":47.6062,\"longitude\":-122.3321,\"confidence\":0.95}]}"
      },
      "weather_forecast": {
        "defaultResponse": "{\"provider\":\"nws\",\"providerReason\":\"us_primary\",\"cache\":{\"hit\":false,\"ageSeconds\":0},\"location\":{\"name\":\"Seattle, Washington, US\",\"countryCode\":\"US\",\"isUs\":true,\"latitude\":47.6062,\"longitude\":-122.3321},\"current\":{\"temperature\":45,\"unit\":\"F\",\"condition\":\"partly cloudy\",\"wind\":\"6 mph\",\"humidityPercent\":72},\"daily\":[{\"date\":\"2026-02-10\",\"tempHigh\":50,\"tempLow\":41,\"avgTemp\":46,\"unit\":\"F\",\"condition\":\"partly cloudy\"}],\"alerts\":[]}"
      }
    }
  },
  "turns": [
    {
      "userMessage": "What's the weather like in Seattle, WA?",
      "expect": {
        "success": true,
        "textContains": ["Seattle"],
        "toolCalls": {
          "include": ["weather_geocode", "weather_forecast"],
          "exclude": ["web_search"]
        },
        "context": {
          "location": "Seattle"
        }
      }
    },
    {
      "userMessage": "today?",
      "expect": {
        "success": true,
        "textContains": ["Using your previous location context", "Seattle"],
        "toolCalls": {
          "include": ["weather_geocode", "weather_forecast"],
          "exclude": ["web_search"]
        },
        "toolArgsContains": ["\"place\":\"Seattle"],
        "toolArgsNotContains": ["\"place\":\"today"],
        "context": {
          "location": "Seattle",
          "locationInferred": true
        }
      }
    }
  ]
}
