<Window x:Class="SirThaddeus.DesktopRuntime.ProfileJsonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Profile"
        Width="760"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Display Name"
                       VerticalAlignment="Center"
                       FontSize="12"/>
            <TextBox x:Name="DisplayNameTextBox"
                     Grid.Column="1"
                     Padding="8,6"
                     FontSize="12"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Profile JSON"
                       FontSize="12"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="ProfileJsonTextBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    IsCancel="True"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Padding="12,6"/>
            <Button Content="Save"
                    IsDefault="True"
                    MinWidth="90"
                    Padding="12,6"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
