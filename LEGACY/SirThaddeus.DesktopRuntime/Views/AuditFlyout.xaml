<UserControl x:Class="SirThaddeus.DesktopRuntime.Views.AuditFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Expander Header="{Binding Count, StringFormat=Audit ({0})}"
              IsExpanded="False">
        <ItemsControl ItemsSource="{Binding}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CrustBrush}"
                            BorderBrush="{DynamicResource Surface0Brush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Step}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BlueBrush}" />
                            <TextBlock Text="{Binding Detail}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Subtext1Brush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding TimestampIso}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Overlay2Brush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Expander>
</UserControl>
