<UserControl x:Class="SirThaddeus.DesktopRuntime.Views.DeepDiveBriefingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SirThaddeus.DesktopRuntime.Views"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource BaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="HistoryColumn" Width="0" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             HISTORY SIDEBAR (collapsible)
             ═══════════════════════════════════════════════════════════ -->
        <views:BriefingHistoryPanel Grid.Column="0"
                                    x:Name="HistoryPanel"
                                    Visibility="Collapsed" />

        <!-- History toggle button (overlaid on left edge of main content) -->
        <Button Grid.Column="1"
                x:Name="HistoryToggle"
                Content="&#x1F4CB;"
                ToolTip="Toggle briefing history"
                Click="HistoryToggle_Click"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="6,6,0,0"
                Padding="6,4"
                FontSize="14"
                Background="{DynamicResource Surface0Brush}"
                Foreground="{DynamicResource TextBrush}"
                BorderBrush="{DynamicResource Surface1Brush}"
                BorderThickness="1"
                Cursor="Hand"
                Panel.ZIndex="10" />

        <!-- ═══════════════════════════════════════════════════════════
             CENTER COLUMN: Main briefing content
             ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12,12,12">
            <StackPanel Margin="32,0,4,0">
                <!-- Status bar (hidden when idle / empty) -->
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource Surface1Brush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasBriefing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource Subtext0Brush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Idle state: nothing requested yet -->
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource Surface1Brush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24,20"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No briefing loaded"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Subtext0Brush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Ask about a place, product, or topic in chat to generate a deep-dive briefing here."
                                   FontSize="12"
                                   Foreground="{DynamicResource Overlay0Brush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="360"/>
                    </StackPanel>
                </Border>

                <!-- Loading state -->
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource Surface1Brush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x23F3;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Preparing briefing..."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Failure state -->
                <Border Background="{DynamicResource ErrorBgBrush}"
                        BorderBrush="{DynamicResource RedBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsFailure, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Briefing Unavailable"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource RedBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Try adding a city/state or refining the place name."
                                   FontSize="12"
                                   Foreground="{DynamicResource YellowBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Hero card -->
                <views:HeroCardControl Visibility="{Binding HasBriefing, Converter={StaticResource BoolToVisibility}}" />

                <!-- Briefing cards -->
                <ItemsControl ItemsSource="{Binding CurrentBriefing.Cards}"
                              Visibility="{Binding HasBriefing, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:BriefingCardControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Audit trail -->
                <views:AuditFlyout DataContext="{Binding CurrentBriefing.Audit}"
                                   Margin="0,6,0,12"
                                   Visibility="{Binding HasBriefing, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════
             RIGHT COLUMN: Sidebar — quick info, reviews, sources
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2"
                BorderBrush="{DynamicResource Surface0Brush}"
                BorderThickness="1,0,0,0"
                Background="{DynamicResource MantleBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14,12">
                <StackPanel Visibility="{Binding HasBriefing, Converter={StaticResource BoolToVisibility}}">

                    <!-- ── Quick Contact ── -->
                    <TextBlock Text="Quick Info"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,10" />

                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource Surface1Brush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Address -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAddress}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#x1F4CD;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding CurrentBriefing.Hero.Address}"
                                           Foreground="{DynamicResource Subtext1Brush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Phone -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPhone}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#x1F4DE;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding PhoneText}"
                                           Foreground="{DynamicResource Subtext1Brush}"
                                           FontSize="11" />
                            </StackPanel>

                            <!-- Website -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWebsite}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#x1F310;" FontSize="12" Margin="0,0,6,0" />
                                <Button Content="Visit website"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="{Binding WebsiteUrl}"
                                        Padding="0" Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource BlueBrush}"
                                        FontSize="11" />
                            </StackPanel>

                            <!-- Directions -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDirections}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#x1F9ED;" FontSize="12" Margin="0,0,6,0" />
                                <Button Content="Get directions"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="{Binding DirectionsUrl}"
                                        Padding="0" Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource BlueBrush}"
                                        FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Review Highlights ── -->
                    <StackPanel Visibility="{Binding HasReviewSnippets, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Review Highlights"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,8" />

                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource Surface1Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,14">
                            <ItemsControl ItemsSource="{Binding ReviewSnippets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource Subtext1Brush}"
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- ── Map ── -->
                    <views:MapPaneControl x:Name="MapPane" Margin="0,0,0,14">
                        <views:MapPaneControl.Style>
                            <Style TargetType="views:MapPaneControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMap}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:MapPaneControl.Style>
                    </views:MapPaneControl>

                    <!-- ── Source Links ── -->
                    <StackPanel Visibility="{Binding HasSidebarSources, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Sources"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,8" />

                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource Surface1Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,14">
                            <ItemsControl ItemsSource="{Binding SidebarSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock FontSize="11" TextWrapping="Wrap">
                                                <Hyperlink NavigateUri="{Binding Url}"
                                                           RequestNavigate="Hyperlink_RequestNavigate"
                                                           Style="{DynamicResource AccentHyperlinkStyle}"
                                                           Cursor="Hand">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
