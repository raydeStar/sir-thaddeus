{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sir-thaddeus.local/schemas/model-qualification-profile-v1.json",
  "title": "Sir Thaddeus model qualification profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "model",
    "sources",
    "runtime_support",
    "recommendations",
    "qualification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": { "type": ["string", "null"] },
        "artifact": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "format": { "type": ["string", "null"] },
            "quantization": { "type": ["string", "null"] },
            "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "revision", "retrieved_utc"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
          "revision": { "type": "string", "minLength": 1 },
          "retrieved_utc": { "type": "string", "format": "date-time" }
        }
      }
    },
    "runtime_support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "source_id"],
        "properties": {
          "backend": { "enum": ["lmstudio", "llamacpp", "external"] },
          "source_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "context_window_tokens", "generation"],
      "properties": {
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "context_window_tokens": { "type": "integer", "minimum": 256, "maximum": 1048576 },
        "generation": {
          "type": "object",
          "required": ["temperature"],
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
          },
          "additionalProperties": true
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "context_window_tokens", "max_output_tokens", "generation"],
      "properties": {
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "override_reason": { "type": ["string", "null"] },
        "context_window_tokens": { "type": "integer", "minimum": 256, "maximum": 1048576 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "generation": {
          "type": "object",
          "required": ["temperature"],
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
