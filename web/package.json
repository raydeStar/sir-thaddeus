{
  "name": "thaddeus-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sir Thaddeus web workspace (Phase 1 scaffold). React 18 + Vite 5 + TanStack Router + Zustand + Tailwind.",
  "scripts": {
    "dev": "vite",
    "routes:gen": "tsr generate",
    "build": "tsr generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b --pretty",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.95.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tanstack/router-cli": "^1.166.33",
    "@tanstack/router-plugin": "^1.95.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^5.4.11"
  }
}
